---
import { renderMarkdown } from '../docs/render-markdown';

export interface DataTableColumn {
	key: string;
	label: string;
	/** Use `<th scope="row">` for this column (first column for equipment-style tables). */
	rowHeader?: boolean;
	/** Cell value is markdown (e.g. equipment descriptions). */
	markdown?: boolean;
	/** Extra classes on each body cell in this column. */
	cellClass?: string;
	/** Header and cell horizontal alignment (default start). */
	align?: 'start' | 'center' | 'end';
}

interface Props {
	columns: DataTableColumn[];
	rows: Record<string, unknown>[];
	ariaLabel?: string;
	wrapClass?: string;
	tableClass?: string;
}

const {
	columns,
	rows,
	ariaLabel,
	wrapClass = '',
	tableClass = '',
} = Astro.props;

function alignClass(align: DataTableColumn['align'] | undefined): string {
	if (align === 'end') return 'text-end';
	if (align === 'center') return 'text-center';
	return 'text-start';
}

type Cell = { kind: 'markdown'; html: string } | { kind: 'text'; text: string };

const bodyRows: Cell[][] = await Promise.all(
	rows.map(async (row) => {
		return Promise.all(
			columns.map(async (col): Promise<Cell> => {
				const raw = row[col.key];
				if (col.markdown && raw != null && String(raw).trim() !== '') {
					return {
						kind: 'markdown',
						html: await renderMarkdown(String(raw)),
					};
				}
				return {
					kind: 'text',
					text: raw != null ? String(raw) : '',
				};
			}),
		);
	}),
);
---

<section
	class:list={['overflow-x-auto', 'my-4', wrapClass]}
	aria-label={ariaLabel}
>
	<table
		class:list={[
			'w-full',
			'border-collapse',
			'text-sm',
			'text-fg',
			/* Book-style: borderless, zebra rows, condensed sans from body */
			tableClass,
		]}
	>
		<thead>
			<tr>
				{
					columns.map((col) => (
						<th
							scope="col"
							class:list={[
								'border-0',
								'bg-transparent',
								'px-3',
								'py-2',
								'align-bottom',
								'font-bold',
								'italic',
								'uppercase',
								'tracking-wide',
								alignClass(col.align),
							]}
						>
							{col.label}
						</th>
					))
				}
			</tr>
		</thead>
		<tbody>
			{
				rows.map((row, ri) => (
					<tr
						class:list={['odd:bg-black/4.5', 'dark:odd:bg-white/6']}
						id={typeof row.id === 'string' ? row.id : undefined}
					>
						{columns.map((col, ci) => {
							const cell = bodyRows[ri]![ci]!;
							const CellTag = col.rowHeader ? 'th' : 'td';
							const baseClass = [
								'border-0',
								'px-3',
								'py-2',
								'align-top',
								'font-normal',
								alignClass(col.align),
								col.cellClass,
							];
							if (cell.kind === 'markdown') {
								return (
									<CellTag
										class:list={baseClass}
										scope={col.rowHeader ? 'row' : undefined}
										set:html={cell.html}
									/>
								);
							}
							return (
								<CellTag
									class:list={baseClass}
									scope={col.rowHeader ? 'row' : undefined}
								>
									{cell.text}
								</CellTag>
							);
						})}
					</tr>
				))
			}
		</tbody>
	</table>
</section>
