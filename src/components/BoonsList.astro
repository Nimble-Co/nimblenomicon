---
import DataTable from './ui/DataTable.astro';
import TermLineList from './ui/TermLineList.astro';
import {
	namedBoonMarkdownLines,
	temporaryBoonTableSpec,
} from '../models/boons';

const { level } = Astro.props as {
	level: 'temporary' | 'minor' | 'major' | 'epic';
};

const tempTable = temporaryBoonTableSpec();
---

{
	level === 'temporary' ? (
		<DataTable
			columns={tempTable.columns}
			rows={tempTable.rows}
			ariaLabel="1d8 temporary boons"
			tableClass="max-w-160"
		/>
	) : (
		<div class="boons-named-list">
			<TermLineList items={namedBoonMarkdownLines(level)} />
		</div>
	)
}

<style>
	.boons-named-list {
		margin-block: 0.75rem;
	}
	.boons-named-list :global(ul) {
		padding-inline-start: 1.25rem;
	}
	.boons-named-list :global(li) {
		margin-block: 0.25rem;
	}
</style>
