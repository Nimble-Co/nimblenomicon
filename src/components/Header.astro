---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

/**
 * Render the `Search` component when Starlight would show it: Pagefind is off in
 * `astro.config.ts`, but the default search component is replaced with our Orama UI.
 */
const shouldRenderSearch =
	config.pagefind ||
	config.components.Search !== '@astrojs/starlight/components/Search.astro';

const pathNormalized = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = pathNormalized === '/';
const showSearch = shouldRenderSearch && !isHome;
---

<div class="nimble-header-inner h-full min-w-0">
	<div
		class="title-wrapper sl-flex min-w-0 overflow-clip p-1 -m-1 md:justify-self-start md:overflow-visible"
	>
		<SiteTitle />
	</div>
	<div class="sl-flex min-w-0 flex-1 print:hidden">
		{showSearch && <Search />}
	</div>
	<div class="right-group items-center gap-4 sl-hidden print:hidden md:sl-flex">
		<div class="social-icons sl-flex items-center gap-4">
			<SocialIcons />
		</div>
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>
