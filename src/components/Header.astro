---
/**
 * Starlight default hides the theme/language row below `50rem` (`sl-hidden md:sl-flex`).
 * Pages without a sidebar (e.g. home) never mount the mobile drawer footer, so theme was
 * unreachable on narrow screens. Show the right group whenever there is no book sidebar.
 *
 * Layout at `md` and grid variables: see `header.header > div.header` in `global.css`.
 */
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
	config.pagefind ||
	config.components.Search !== '@astrojs/starlight/components/Search.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
const rightGroupClasses = hasSidebar
	? 'right-group sl-hidden items-center gap-4 md:sl-flex print:hidden'
	: 'right-group sl-flex items-center gap-4 print:hidden';
---

<div
	class="header flex h-full w-full min-w-0 items-center justify-between gap-nav-gap"
>
	<div class="title-wrapper sl-flex min-w-0 overflow-x-clip p-1 -m-1">
		<SiteTitle />
	</div>
	<div class="sl-flex print:hidden">
		{shouldRenderSearch && <Search />}
	</div>
	<div class={rightGroupClasses}>
		<div
			class="social-icons empty:hidden sl-flex items-center gap-4 after:ms-4 after:inline-block after:h-8 after:w-px after:shrink-0 after:bg-gray-500 after:content-['']"
		>
			<SocialIcons />
		</div>
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>
