---
/**
 * Section icon + title above the sidebar nav (matches home tile artwork in `HomeLanding.astro`).
 */
import { SECTION_METADATA, type SectionKey } from '../config/section-sidebars';

interface Props {
	sectionKey: SectionKey;
}

const { sectionKey } = Astro.props;

const brand = SECTION_METADATA[sectionKey];
---

<div class="nimble-section-brand">
	<img
		class="nimble-section-brand__icon"
		src={brand.icon.src}
		width={brand.sidebar.width}
		height={brand.sidebar.height}
		alt=""
		aria-hidden="true"
	/>
	<p class="nimble-section-brand__title">{brand.label}</p>
</div>

<style>
	.nimble-section-brand {
		padding: 0.65rem 0.5rem 0.85rem;
		text-align: center;
		margin: 0 0 0.65rem;
		border: 1px solid var(--nimble-book-sidebar-border, #c8c8c8);
		border-radius: var(--nimble-book-sidebar-radius, 0.625rem);
		background: var(--nimble-book-sidebar-tile-bg, #ebebeb);
	}

	.nimble-section-brand__icon {
		display: block;
		margin: 0 auto 0.45rem;
		width: 2.5rem;
		height: auto;
	}

	.nimble-section-brand__title {
		margin: 0;
		font-family: var(--nimble-font-heading);
		font-size: 0.8125rem;
		font-weight: 700;
		font-style: italic;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--nimble-book-sidebar-fg, #252b42);
	}

	:global(:root[data-theme='dark']) .nimble-section-brand {
		border-color: var(--sl-color-hairline);
		background: color-mix(in srgb, var(--sl-color-bg-nav) 90%, var(--sl-color-gray-5));
	}

	:global(:root[data-theme='dark']) .nimble-section-brand__title {
		color: var(--sl-color-text);
	}
</style>
