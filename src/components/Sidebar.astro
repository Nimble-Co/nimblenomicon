---
import { PAGE_TITLE_ID } from '../../node_modules/@astrojs/starlight/constants.ts';
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import NavSidebarPersister from './NavSidebarPersister.astro';
import SectionSidebarBrand from './SectionSidebarBrand.astro';
import SidebarSublist from './SidebarSublist.astro';
import { resolveSectionSidebar } from '../utils/section-sidebar';

const { toc } = Astro.locals.starlightRoute;
/** Starlight prepends a synthetic `#_top` item labeled “Overview”; omit it in the left sidebar. */
const tocWithoutOverview = toc
	? {
			...toc,
			items: toc.items.filter((item) => item.slug !== PAGE_TITLE_ID),
		}
	: toc;
const pathname = Astro.url.pathname;
const urlHash = Astro.url.hash.replace(/^#/, '');
const { sidebar, bookChrome, sectionKey } = resolveSectionSidebar(
	Astro.locals.starlightRoute,
	pathname,
	urlHash,
);

/** Book nav lists every section; hide duplicate Starlight TOC under the sidebar. */
const tocForBook =
	bookChrome && tocWithoutOverview
		? {
				...tocWithoutOverview,
				items: [] as (typeof tocWithoutOverview)['items'],
			}
		: tocWithoutOverview;
---

<NavSidebarPersister sidebar={sidebar}>
	{sectionKey && <SectionSidebarBrand sectionKey={sectionKey} />}
	<div class:list={{ 'nimble-book-shell': bookChrome }}>
		<SidebarSublist
			sublist={sidebar}
			toc={tocForBook}
			bookChrome={bookChrome}
		/>
	</div>
</NavSidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>

<script>
	import '../../node_modules/@astrojs/starlight/components-internals/TableOfContents/starlight-toc.ts';
</script>
