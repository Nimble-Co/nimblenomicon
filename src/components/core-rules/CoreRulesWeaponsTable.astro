---
import CoreRulesTableThead from './CoreRulesTableThead.astro';
import { weaponDetailHrefFromCoreRules, weapons } from '../../models/weapons';

interface Props {
	category: 'melee' | 'ranged';
}

const { category } = Astro.props;
const rows = weapons.filter((w) => w.category === category);
---

<table>
	<CoreRulesTableThead labels={['ITEM', 'DAMAGE', 'PROPERTIES', 'COST']} />
	<tbody>
		{
			rows.map((w) => (
				<tr id={w.id}>
					<th scope="row">
						<a href={weaponDetailHrefFromCoreRules(w.id)}>{w.name}</a>
					</th>
					<td>{w.damage}</td>
					<td>{w.propertyLines.map((p) => p.description).join(', ')}</td>
					<td>{w.cost}</td>
				</tr>
			))
		}
	</tbody>
</table>
