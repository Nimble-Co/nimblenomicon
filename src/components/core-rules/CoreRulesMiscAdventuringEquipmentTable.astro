---
import CoreRulesTableThead from './CoreRulesTableThead.astro';
import { renderMarkdown } from '../../lib/render-markdown';
import {
	miscAdventuringEquipment,
	miscAdventuringEquipmentDetailHrefFromCoreRules,
} from '../../models/misc-adventuring-equipment';
---

<table>
	<CoreRulesTableThead labels={['ITEM', 'PROPERTIES', 'COST']} />
	<tbody>
		{
			miscAdventuringEquipment.map((row) => (
				<tr id={row.id}>
					<th scope="row">
						<a href={miscAdventuringEquipmentDetailHrefFromCoreRules(row.id)}>
							{row.name}
						</a>
					</th>
					<td set:html={renderMarkdown(row.description)} />
					<td>{row.cost}</td>
				</tr>
			))
		}
	</tbody>
</table>
