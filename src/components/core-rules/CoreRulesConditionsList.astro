---
import { listLabel } from '../../lib/list-label';
import { conditions } from '../../models/conditions';
---

<ul>
	{
		conditions.map((condition) => (
			<li id={condition.id}>
				<a href={`/conditions/${condition.id}/`}>
					<strong>{listLabel(condition.name)}</strong>
				</a>
				{' ' + condition.description}
			</li>
		))
	}
</ul>
