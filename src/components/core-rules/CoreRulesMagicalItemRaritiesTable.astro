---
import CoreRulesTableThead from './CoreRulesTableThead.astro';
import { magicalItemRarities } from '../../models/magical-item-rarities';
---

<table>
	<CoreRulesTableThead labels={['RARITY', 'TYPICAL AVAILABILITY', 'COST']} />
	<tbody>
		{
			magicalItemRarities.map((row) => (
				<tr>
					<td>{row.name}</td>
					<td>{row.availability}</td>
					<td>{row.cost}</td>
				</tr>
			))
		}
	</tbody>
</table>
