---
import { renderMarkdown } from '../../lib/render-markdown';
import { formatSpellTarget, formatSpellTier } from '../../lib/spell-meta';
import { spells, type SpellData } from '../../models/spells';

const { spellSchoolId, utility = false } = Astro.props;
const filteredSpells = spells.filter(
	(spell) => spell.schoolId === spellSchoolId && spell.utility === utility,
);

function spellMetaMarkdown(spell: SpellData): string {
	const tierLabel = formatSpellTier(spell.tier);
	const cast = spell.castingTime.trim();
	const tgt = spell.target ? formatSpellTarget(spell.target) : '';
	const components = [tierLabel, cast, tgt];
	const middle = components.filter(Boolean).join(', ');
	return `_${middle}_`;
}
---

{
	(
		<>
			{filteredSpells.map((spell) => (
				<>
					<h3 id={spell.id}>
						<a href={`/spells/${spell.id}/`}>{spell.name}</a>
					</h3>
					<div
						set:html={renderMarkdown(
							spellMetaMarkdown(spell) +
								(spell.description?.trim() ? '\n\n' + spell.description : ''),
						)}
					/>
				</>
			))}
		</>
	)
}
