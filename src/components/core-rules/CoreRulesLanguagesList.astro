---
import { listLabel } from '../../lib/list-label';
import { languages } from '../../models/languages';
---

<ul>
	{
		languages.map((language) => (
			<li id={language.id}>
				<a href={`/languages/${language.id}/`}>
					<strong>{listLabel(language.name)}</strong>
				</a>
				{' ' + language.description}
			</li>
		))
	}
</ul>
