---
import { renderMarkdown } from '../../lib/render-markdown';
import { weaponProperties } from '../../models/weapon-properties';
---

<ul>
	{
		weaponProperties.map(async (weaponProperty) => (
			<li
				set:html={await renderMarkdown(
					`**${weaponProperty.name}.** ${weaponProperty.description}`,
				)}
			/>
		))
	}
</ul>
