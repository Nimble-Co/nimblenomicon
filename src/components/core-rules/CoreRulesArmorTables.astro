---
import CoreRulesTableThead from './CoreRulesTableThead.astro';
import {
	armorDetailHrefFromCoreRules,
	armorRows,
	armorTableSections,
} from '../../models/armor';
---

{
	armorTableSections.map(({ category: cat, label }) => (
		<>
			<h3>{label}</h3>
			<table>
				<CoreRulesTableThead labels={['ITEM', 'ARMOR', 'COST']} />
				<tbody>
					{armorRows
						.filter((row) => row.category === cat)
						.map((row) => (
							<tr id={row.id}>
								<th scope="row">
									<a href={armorDetailHrefFromCoreRules(row.id)}>{row.name}</a>
								</th>
								<td>{row.armor}</td>
								<td>{row.cost}</td>
							</tr>
						))}
				</tbody>
			</table>
		</>
	))
}
