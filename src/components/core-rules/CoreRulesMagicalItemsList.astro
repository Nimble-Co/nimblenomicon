---
import { renderMarkdown } from '../../lib/render-markdown';
import {
  compareMagicalItemsForListing,
  magicalItemDetailHrefFromCoreRules,
  magicalItems,
  type MagicalItemData,
} from '../../models/magical-items';

interface Props {
	kind?: MagicalItemData['kind'];
}

const { kind } = Astro.props;

const rows = kind
	? magicalItems
			.filter((item) => item.kind === kind)
			.sort(compareMagicalItemsForListing)
	: magicalItems;
---

{
	rows.map(async (item) => (
		<>
			<h3 id={item.id}>
				<a href={magicalItemDetailHrefFromCoreRules(item.id)}>{item.name}</a>
			</h3>
			{item.subtitle && <div set:html={await renderMarkdown(item.subtitle)} />}
			<div set:html={await renderMarkdown(item.description)} />
		</>
	))
}
