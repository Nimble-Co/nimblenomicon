---
import { renderMarkdown } from '../../lib/render-markdown';
import { boonsByLevel, type NamedBoonData } from '../../models/boons';

const { level } = Astro.props as { level: 'minor' | 'major' | 'epic' };
const rows = boonsByLevel(level);

function itemMarkdown(row: NamedBoonData): string {
	return `- **${row.name}**. ${row.description.trim()}`;
}
---

<ul class="gmg-boons-list">
	{
		rows.map(async (row) => (
			<li set:html={await renderMarkdown(itemMarkdown(row))} />
		))
	}
</ul>

<style>
	.gmg-boons-list {
		margin-block: 0.75rem;
		padding-inline-start: 1.25rem;
	}
	.gmg-boons-list :global(li) {
		margin-block: 0.25rem;
	}
</style>
