---
import { gmgGoldByLevel } from '../../models/gmg-gold-by-level';
---

<section class="gmg-data-table-wrap" aria-label="Gold per level">
	<table class="gmg-data-table">
		<thead>
			<tr>
				<th scope="col">Level</th>
				<th scope="col">Gold</th>
			</tr>
		</thead>
		<tbody>
			{
				gmgGoldByLevel.map((row) => (
					<tr>
						<td>{row.level}</td>
						<td>{row.gold.toLocaleString()}</td>
					</tr>
				))
			}
		</tbody>
	</table>
</section>

<style>
	.gmg-data-table-wrap {
		overflow-x: auto;
		margin-block: 1rem;
	}
	.gmg-data-table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--sl-text-sm);
	}
	.gmg-data-table th,
	.gmg-data-table td {
		border: 1px solid var(--sl-color-hairline);
		padding: 0.5rem 0.65rem;
		text-align: start;
	}
	.gmg-data-table th {
		background: var(--sl-color-bg-sidebar);
	}
</style>
