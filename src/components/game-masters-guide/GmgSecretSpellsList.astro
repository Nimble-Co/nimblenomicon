---
import { renderMarkdown } from '../../lib/render-markdown';
import { spellMetaMarkdown } from '../../lib/spell-meta';
import { gmgSecretSpellIds } from '../../models/gmg-secret-spell-ids';
import { spellDetailHrefFromCoreRules, spellRows } from '../../models/spells';
---

{
	gmgSecretSpellIds.map((spellId) => {
		const row = spellRows.find((r) => r.id === spellId);
		if (!row) {
			throw new Error(
				`GmgSecretSpellsList: no spell with id "${spellId}" in spells data.`,
			);
		}
		const spell = {
			id: row.id,
			name: row.name,
			tier: row.tier,
			castingTime: row.castingTime,
			target: row.target,
			description: row.description,
		};
		return (
			<>
				<h3 id={spell.id}>
					<a href={spellDetailHrefFromCoreRules(spell.id)}>{spell.name}</a>
				</h3>
				<div
					set:html={renderMarkdown(
						spellMetaMarkdown(spell.tier, spell.castingTime, spell.target) +
							(spell.description?.trim() ? '\n\n' + spell.description : ''),
					)}
				/>
			</>
		);
	})
}
