---
export type Props = {
	type: string;
	name?: string;
};

const { type, name } = Astro.props;
const typeFilter = `type:${type}`;
---

<span
	class="sr-only"
	aria-hidden="true"
	data-pagefind-filter={typeFilter}
/>

<div data-pagefind-weight="10">
	{name && <span class="sr-only">{name}</span>}
	<slot />
</div>

