---
import { Icon } from '@astrojs/starlight/components';
import project from 'virtual:starlight/project-context';
import { SEARCH_PLACEHOLDER } from '../config/search';
import { searchPageUrl } from '../utils/url';
import OramaQuickSearchField from './orama-search/OramaQuickSearchField.svelte';

const searchPlaceholder = SEARCH_PLACEHOLDER;

const searchAction = searchPageUrl(
	import.meta.env.BASE_URL,
	project.trailingSlash,
);

const rootClass =
	'flex w-full min-w-0 flex-nowrap items-center gap-2 max-[49.999rem]:group-data-[mobile-search-open=false]:justify-end';

const ctrlKeyLabel = Astro.locals.t('search.ctrlKey');
---

<site-search
	class:list={['group', 'contents', Astro.props.class]}
	data-mobile-search-open="false"
>
	<div class={rootClass}>
		<button
			type="button"
			class="ss-mobile-toggle flex h-10 w-10 shrink-0 cursor-pointer items-center justify-center rounded-lg border-0 bg-transparent text-xl text-fg-muted hover:text-fg min-[50rem]:hidden"
			aria-expanded="false"
			aria-controls="ss-mobile-search-panel"
			aria-label={searchPlaceholder}
		>
			<Icon name="magnifier" />
		</button>
		<div
			id="ss-mobile-search-panel"
			class="ss-mobile-panel flex min-w-0 flex-1 min-[50rem]:hidden"
			hidden
		>
			<OramaQuickSearchField
				client:load
				variant="header-mobile"
				placeholder={searchPlaceholder}
				action={searchAction}
			/>
		</div>
		<OramaQuickSearchField
			client:load
			variant="header-desktop"
			placeholder={searchPlaceholder}
			action={searchAction}
			ctrlKeyLabel={ctrlKeyLabel}
		/>
	</div>
</site-search>

<!-- Inline: ⌘ + aria-keyshortcuts on Apple (see Starlight Search.astro). -->
<script is:inline>
	(() => {
		const platformKey = document.querySelector(
			'.ss-desktop-form .ss-kbd > kbd:first-of-type',
		);
		const desktopInput = document.querySelector('#ss-desktop-q');
		if (!platformKey || !/(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
			return;
		}
		platformKey.textContent = '⌘';
		desktopInput?.setAttribute('aria-keyshortcuts', 'Meta+K');
	})();
</script>

<script>
	import '../search/site-search-element';
</script>
