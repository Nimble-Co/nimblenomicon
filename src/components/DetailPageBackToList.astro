---
/**
 * Back link above detail-page body: arrow + label to browse that entity type on /search/.
 */
import Icon from '../../node_modules/@astrojs/starlight/user-components/Icon.astro';
import type { OramaDataSearchType } from '../constants/orama-data-search';
import { dataSearchBrowseUrl } from '../utils/url';
import project from 'virtual:starlight/project-context';

export interface Props {
	label: string;
	searchType: OramaDataSearchType;
}

const { label, searchType } = Astro.props;

const href = dataSearchBrowseUrl(
	import.meta.env.BASE_URL,
	project.trailingSlash,
	searchType,
);

const dir = Astro.locals.starlightRoute?.dir ?? 'ltr';
const isRtl = dir === 'rtl';
---

<p class="m-0 mb-4 print:hidden" dir={dir}>
	<a
		class="text-fg-muted hover:text-fg inline-flex items-center gap-2 text-sm no-underline"
		href={href}
	>
		<span class="shrink-0" aria-hidden="true">
			<Icon name={isRtl ? 'right-arrow' : 'left-arrow'} size="1.25rem" />
		</span>
		<span>{label}</span>
	</a>
</p>
