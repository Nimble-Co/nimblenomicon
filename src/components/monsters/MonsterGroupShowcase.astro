---
import { renderMarkdown } from '../../lib/render-markdown';
import { getMonsterGroupById } from '../../models/monster-groups';
import { getMonstersByGroupId } from '../../models/monsters';
import MonsterStatBlock from './MonsterStatBlock.astro';

interface Props {
	groupId: string;
}

const { groupId } = Astro.props;

const group = getMonsterGroupById(groupId);
const monstersInGroup = group ? getMonstersByGroupId(groupId) : [];

const descriptionHtml = group ? await renderMarkdown(group.description) : '';
const sharedAbilityDescHtml = group?.sharedAbility
	? await renderMarkdown(group.sharedAbility.description)
	: '';
const sampleEncountersHtml = group
	? await renderMarkdown(group.sampleEncounters)
	: '';
---

{
	group && (
		<section class="my-6" aria-labelledby={`monster-group-${group.id}`}>
			<h2 class="mb-2 text-xl font-bold" id={`monster-group-${group.id}`}>
				{group.name}
			</h2>
			<div class="mb-4 italic [&_p]:m-0" set:html={descriptionHtml} />

			{group.sharedAbility && (
				<div class="mb-4 rounded-md bg-gray-200 p-3 dark:bg-gray-700">
					<p class="mb-1 font-bold">{group.sharedAbility.name}</p>
					<div class="text-sm [&_p]:m-0" set:html={sharedAbilityDescHtml} />
				</div>
			)}

			<div class="mb-6 flex flex-col items-start gap-4">
				{monstersInGroup.map((monster) => (
					<MonsterStatBlock monster={monster} />
				))}
			</div>

			<div class="mb-5">
				<h3 class="mb-1 text-base font-bold">{group.name} Loot</h3>
				<p class="m-0 text-sm leading-relaxed">{group.potentialLoot}</p>
			</div>

			<div>
				<h3 class="mb-1 text-base font-bold">Sample Encounters</h3>
				<div
					class="text-sm leading-relaxed [&_p]:mb-2 [&_p:last-child]:mb-0 [&_ul]:my-0 [&_ul]:pl-5"
					set:html={sampleEncountersHtml}
				/>
			</div>
		</section>
	)
}
