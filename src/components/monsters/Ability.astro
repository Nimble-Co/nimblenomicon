---
const { name, description } = Astro.props;
---

<section
	class="mt-3 rounded-md border border-hairline bg-surface-code p-2 text-base italic leading-snug text-fg"
>
	<h3 class="m-0 inline text-base font-bold">{name}</h3>{' '}
	<span class="[&_p]:m-0 [&_p]:inline" set:html={description} />
</section>
