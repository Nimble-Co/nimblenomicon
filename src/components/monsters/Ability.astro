---
const { name, description } = Astro.props;
---

<section
	class="mt-3 rounded-md border border-[var(--sl-color-hairline-light)] bg-[var(--sl-color-bg-inline-code)] p-2 text-base italic leading-snug text-[var(--sl-color-text)]"
>
	<h3 class="m-0 inline text-base font-bold">{name}</h3>{' '}
	<span class="[&_p]:m-0 [&_p]:inline" set:html={description} />
</section>
