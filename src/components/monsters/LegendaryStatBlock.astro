---
import { renderMarkdown } from '../../lib/render-markdown';
import { slugifyEntityId } from '../../lib/slugifyEntityId';
import {
	legendaryMonsters,
	type LegendaryMonsterData,
} from '../../models/legendary-monsters';
import { sizes } from '../../models/sizes';
import { monsterActionSchema, type MonsterAction } from '../../models/monsters';
import Ability from './Ability.astro';

interface Props {
	legendaryMonsterId: string;
}

const { legendaryMonsterId } = Astro.props;

function sizeLabel(sizeSlug: string): string {
	const match = sizes.find((s) => slugifyEntityId(s.name, 'size') === sizeSlug);
	return match?.name ?? sizeSlug;
}

function actionHeading(action: MonsterAction): string {
	const uses = action.uses != null ? ` (${action.uses}x)` : '';
	const endsSentence = /[.!?;:]$/.test(action.name.trim());
	return `${action.name}${uses}${endsSentence ? '' : '.'}`;
}

const SPEED_MODE_LABEL: Record<
	LegendaryMonsterData['movement']['mode'],
	string
> = {
	walk: 'Walk',
	fly: 'Fly',
	burrow: 'Burrow',
	swim: 'Swim',
};

const armorAbbrev: Record<LegendaryMonsterData['armor'], string | null> = {
	none: null,
	medium: 'M',
	heavy: 'H',
};

const SAVE_LABEL: Record<string, string> = {
	str: 'STR',
	dex: 'DEX',
	con: 'CON',
	int: 'INT',
	wil: 'WIL',
	cha: 'CHA',
	all: 'ALL',
};

function primarySaveDisplay(
	saves: LegendaryMonsterData['saves'],
): string | null {
	if (!saves) return null;

	if (typeof saves.all === 'number' && saves.all !== 0) {
		const n = saves.all;
		const sign = n > 0 ? '+'.repeat(n) : '-'.repeat(-n);
		return `ALL${sign}`;
	}

	const order = ['str', 'dex', 'con', 'int', 'wil', 'cha'] as const;
	let bestKey: (typeof order)[number] | undefined;
	let bestVal = 0;
	for (const k of order) {
		const v = saves[k];
		if (typeof v === 'number' && v > bestVal) {
			bestVal = v;
			bestKey = k;
		}
	}
	if (bestKey !== undefined && bestVal > 0) {
		return `${SAVE_LABEL[bestKey]}${'+'.repeat(bestVal)}`;
	}
	return null;
}

const monster = legendaryMonsters.find((m) => m.id === legendaryMonsterId);

if (!monster) {
	throw new Error(`Legendary monster with id ${legendaryMonsterId} not found`);
}

const primarySave = primarySaveDisplay(monster.saves);

const hasArmorBadge = Boolean(armorAbbrev[monster.armor]);

const showSize = monster.size !== 'medium';
const showSpeed =
	monster.movement.mode !== 'walk' || monster.movement.speed !== 6;

const actionDescriptionHtml = await Promise.all(
	monster.actions.map((a) =>
		renderMarkdown(monsterActionSchema.parse(a).description),
	),
);

const bloodiedHtml = monster.bloodied
	? await renderMarkdown(monster.bloodied)
	: null;
const lastStandHtml = await renderMarkdown(monster.lastStand);
const notesHtml = monster.notes ? await renderMarkdown(monster.notes) : null;

const metaParts: string[] = [`Level ${monster.level}`, 'Solo'];
if (showSize) {
	metaParts.push(sizeLabel(monster.size));
}
metaParts.push(monster.creatureType);
const metaLine = metaParts.join(', ');
---

<article
	class="w-full max-w-xl rounded-md border-4 border-double border-gray-300 bg-surface p-2"
>
	<header class="flex items-end justify-between gap-3">
		<hgroup class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2">
			<h2 class="text-xl font-bold leading-none">{monster.name}</h2>
			<p
				class="m-0 text-xs font-normal italic leading-none tracking-wide text-gray-500 uppercase"
			>
				{metaLine}
			</p>
		</hgroup>

		<ul
			class="m-0 flex shrink-0 list-none flex-wrap items-end justify-end gap-2 p-0 text-base font-bold tabular-nums"
			aria-label="Quick stats"
		>
			{
				hasArmorBadge && (
					<li>
						<span
							class="inline-flex h-6 min-w-6 items-center justify-center border border-gray-300 text-xs"
							title="Armor"
						>
							{armorAbbrev[monster.armor]}
						</span>
					</li>
				)
			}
			<li>
				<span title="Hit points">
					<span aria-hidden="true">♥</span>
					{monster.hp}
				</span>
			</li>
			{
				primarySave && (
					<li>
						<span title="Primary save advantage">
							<span aria-hidden="true">★</span>
							{primarySave}
						</span>
					</li>
				)
			}
			{
				showSpeed && (
					<li>
						<span class="text-gray-600">
							{SPEED_MODE_LABEL[monster.movement.mode]} {monster.movement.speed}
						</span>
					</li>
				)
			}
		</ul>
	</header>

	{
		monster.specialAbilities.map((ability) => (
			<Ability name={ability.name} description={ability.description} />
		))
	}

	{
		monster.actions.length > 0 && (
			<div class="mt-3 text-base leading-relaxed">
				{monster.actionsIntro && (
					<p class="m-0 mb-1.5 font-bold">ACTIONS: {monster.actionsIntro}</p>
				)}
				{monster.actions.length === 1 ? (
					<div class="m-0">
						<strong>{actionHeading(monster.actions[0]!)}</strong>{' '}
						<span
							class="inline [&_p]:m-0 [&_p]:inline"
							set:html={actionDescriptionHtml[0]}
						/>
						{monster.actions[0]!.joinNext === 'or' && ' OR:'}
						{monster.actions[0]!.joinNext === 'then' && ' Then:'}
					</div>
				) : (
					<ul class="m-0 list-none space-y-1.5 p-0">
						{monster.actions.map((action, i) => (
							<li class="m-0 flex gap-1">
								<span class="shrink-0" aria-hidden="true">
									•
								</span>
								<span class="min-w-0">
									<strong>{actionHeading(action)}</strong>{' '}
									<span
										class="inline [&_p]:m-0 [&_p]:inline"
										set:html={actionDescriptionHtml[i]}
									/>
									{action.joinNext === 'or' && ' OR:'}
									{action.joinNext === 'then' && ' Then:'}
								</span>
							</li>
						))}
					</ul>
				)}
			</div>
		)
	}

	<div
		class:list={[
			'mt-3 gap-3 text-base leading-relaxed sm:gap-4',
			bloodiedHtml ? 'grid sm:grid-cols-2' : '',
		]}
	>
		{
			bloodiedHtml && (
				<section class="m-0">
					<h3 class="m-0 text-sm font-bold uppercase tracking-wide">
						Bloodied
					</h3>
					<div
						class="[&_strong]:text-red-600 dark:[&_strong]:text-red-400 [&_p]:m-0"
						set:html={bloodiedHtml}
					/>
				</section>
			)
		}
		<section class="m-0">
			<h3 class="m-0 text-sm font-bold uppercase tracking-wide">Last Stand</h3>
			<div
				class="[&_strong]:text-red-600 dark:[&_strong]:text-red-400 [&_p]:m-0"
				set:html={lastStandHtml}
			/>
		</section>
	</div>

	{
		notesHtml && (
			<div
				class="mt-3 text-base leading-relaxed [&_p]:mb-2 [&_p:last-child]:mb-0"
				set:html={notesHtml}
			/>
		)
	}
</article>
