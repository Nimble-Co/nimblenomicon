---
import { renderMarkdown } from '../../lib/render-markdown';
import { slugifyEntityId } from '../../lib/slugifyEntityId';
import {
	legendaryMonsters,
	type LegendaryCreatureData,
} from '../../models/legendary-monsters';
import { sizes } from '../../models/sizes';
import { monsterActionSchema, type MonsterAction } from '../../models/monsters';
import Ability from './Ability.astro';

interface Props {
	legendaryMonsterId: string;
}

const { legendaryMonsterId } = Astro.props;

function sizeLabel(sizeSlug: string): string {
	const match = sizes.find((s) => slugifyEntityId(s.name, 'size') === sizeSlug);
	return match?.name ?? sizeSlug;
}

function actionHeading(action: MonsterAction): string {
	const uses = action.uses != null ? ` (${action.uses}x)` : '';
	const endsSentence = /[.!?;:]$/.test(action.name.trim());
	return `${action.name}${uses}${endsSentence ? '' : '.'}`;
}

const SPEED_MODE_LABEL: Record<string, string> = {
	walk: 'Walk',
	fly: 'Fly',
	burrow: 'Burrow',
	swim: 'Swim',
};

const armorAbbrev: Record<'none' | 'medium' | 'heavy', string | null> = {
	none: null,
	medium: 'M',
	heavy: 'H',
};

const SAVE_LABEL: Record<string, string> = {
	str: 'STR',
	dex: 'DEX',
	int: 'INT',
	wil: 'WIL',
	all: 'ALL',
};

function saveBadgeStrings(saves: LegendaryCreatureData['saves']): string[] {
	if (!saves) return [];

	if (typeof saves.all === 'number' && saves.all !== 0) {
		const n = saves.all;
		const sign = n > 0 ? '+'.repeat(n) : '-'.repeat(-n);
		return [`ALL${sign}`];
	}

	const order = ['str', 'dex', 'int', 'wil'] as const;
	const out: string[] = [];
	for (const k of order) {
		const v = saves[k];
		if (typeof v === 'number' && v > 0) {
			out.push(`${SAVE_LABEL[k]}${'+'.repeat(v)}`);
		}
	}
	return out;
}

const monster = legendaryMonsters.find((m) => m.id === legendaryMonsterId);

if (!monster) {
	throw new Error(`Legendary monster with id ${legendaryMonsterId} not found`);
}

const isTeam = monster.creatures.length > 1;
const soloCreature = isTeam ? null : monster.creatures[0]!;

const bloodiedHtml = monster.bloodied
	? await renderMarkdown(monster.bloodied)
	: null;
const lastStandHtml = monster.lastStand
	? await renderMarkdown(monster.lastStand)
	: null;
const notesHtml = monster.notes ? await renderMarkdown(monster.notes) : null;

const soloActionHtml = soloCreature
	? await Promise.all(
			soloCreature.actions.map((a) =>
				renderMarkdown(monsterActionSchema.parse(a).description),
			),
		)
	: [];

const teamMemberActionHtml: string[][] = isTeam
	? await Promise.all(
			monster.creatures.map((creature) =>
				Promise.all(
					creature.actions.map((a) =>
						renderMarkdown(monsterActionSchema.parse(a).description),
					),
				),
			),
		)
	: [];
---

<article
	class="w-full max-w-xl rounded-md border-4 border-double border-hairline bg-surface p-2 text-fg"
>
	{
		!isTeam && soloCreature ? (
			<>
				<header class="flex items-end justify-between gap-3 border-b border-hairline pb-2">
					<hgroup class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2">
						<h2 class="text-xl font-bold leading-none">{monster.name}</h2>
						<p class="m-0 text-xs font-normal uppercase italic leading-none tracking-wide text-fg-muted">
							{[
								`Level ${monster.level}`,
								'Solo',
								soloCreature.size !== 'medium'
									? sizeLabel(soloCreature.size)
									: null,
								monster.creatureType,
							]
								.filter(Boolean)
								.join(', ')}
						</p>
					</hgroup>

					<ul
						class="m-0 flex shrink-0 list-none flex-wrap items-end justify-end gap-2 p-0 text-base font-bold tabular-nums"
						aria-label="Quick stats"
					>
						{Boolean(armorAbbrev[soloCreature.armor]) && (
							<li>
								<span
									class="inline-flex h-6 min-w-6 items-center justify-center border border-hairline text-xs"
									title="Armor"
								>
									{armorAbbrev[soloCreature.armor]}
								</span>
							</li>
						)}
						<li>
							<span title="Hit points">
								<span aria-hidden="true">♥</span>
								{soloCreature.hp}
							</span>
						</li>
						{saveBadgeStrings(soloCreature.saves).map((badge) => (
							<li>
								<span title="Save modifier">
									<span aria-hidden="true">★</span>
									{badge}
								</span>
							</li>
						))}
						{(soloCreature.movement.mode !== 'walk' ||
							soloCreature.movement.speed !== 6) && (
							<li>
								<span class="text-fg-muted">
									{SPEED_MODE_LABEL[soloCreature.movement.mode]}{' '}
									{soloCreature.movement.speed}
								</span>
							</li>
						)}
					</ul>
				</header>

				{soloCreature.specialAbilities.map((ability) => (
					<Ability name={ability.name} description={ability.description} />
				))}

				{soloCreature.actions.length > 0 && (
					<div class="mt-3 text-base leading-relaxed">
						{monster.actionsIntro && (
							<p class="m-0 mb-1.5 font-bold">
								ACTIONS: {monster.actionsIntro}
							</p>
						)}
						{soloCreature.actions.length === 1 ? (
							<div class="m-0">
								<strong>{actionHeading(soloCreature.actions[0]!)}</strong>{' '}
								<span
									class="inline [&_p]:m-0 [&_p]:inline"
									set:html={soloActionHtml[0]}
								/>
								{soloCreature.actions[0]!.joinNext === 'or' && ' OR:'}
								{soloCreature.actions[0]!.joinNext === 'then' && ' Then:'}
							</div>
						) : (
							<ul class="m-0 list-outside list-disc space-y-1.5 pl-5 text-base leading-relaxed">
								{soloCreature.actions.map((action, i) => (
									<li class="m-0 pl-1">
										<strong>{actionHeading(action)}</strong>{' '}
										<span
											class="inline [&_p]:m-0 [&_p]:inline"
											set:html={soloActionHtml[i]}
										/>
										{action.joinNext === 'or' && ' OR:'}
										{action.joinNext === 'then' && ' Then:'}
									</li>
								))}
							</ul>
						)}
					</div>
				)}
			</>
		) : (
			<>
				<header class="border-b border-hairline pb-2">
					<hgroup class="flex min-w-0 flex-col gap-1">
						<p class="m-0 text-xs font-normal uppercase italic leading-none tracking-wide text-fg-muted">
							Level {monster.level} Solo {monster.creatureType}
						</p>
						<h2 class="m-0 text-xl font-bold leading-none">{monster.name}</h2>
					</hgroup>
				</header>

				{monster.actionsIntro && (
					<p class="m-0 mt-3 font-bold">ACTIONS: {monster.actionsIntro}</p>
				)}

				<div class="mt-3">
					{monster.creatures.map((member, mi) => (
						<div class:list={[mi > 0 && 'mt-3 border-t border-hairline pt-3']}>
							<h3 class="m-0 text-base font-bold uppercase tracking-wide">
								{member.name}
								{member.roleLabel && (
									<span class="font-normal normal-case">
										{' '}
										({member.roleLabel})
									</span>
								)}
							</h3>
							<ul
								class="m-0 mt-1 flex list-none flex-wrap items-center gap-x-3 gap-y-1 p-0 text-base font-bold tabular-nums"
								aria-label={`Quick stats for ${member.name}`}
							>
								{member.size !== 'medium' && (
									<li class="text-fg-muted">{sizeLabel(member.size)}</li>
								)}
								{Boolean(armorAbbrev[member.armor]) && (
									<li>
										<span
											class="inline-flex h-6 min-w-6 items-center justify-center border border-hairline text-xs"
											title="Armor"
										>
											{armorAbbrev[member.armor]}
										</span>
									</li>
								)}
								<li>
									<span title="Hit points">
										<span aria-hidden="true">♥</span>
										{member.hp}
									</span>
								</li>
								{saveBadgeStrings(member.saves).map((badge) => (
									<li>
										<span title="Save modifier">
											<span aria-hidden="true">★</span>
											{badge}
										</span>
									</li>
								))}
								{(member.movement.mode !== 'walk' ||
									member.movement.speed !== 6) && (
									<li>
										<span class="text-fg-muted">
											{SPEED_MODE_LABEL[member.movement.mode]}{' '}
											{member.movement.speed}
										</span>
									</li>
								)}
							</ul>

							{member.specialAbilities.map((ability) => (
								<Ability
									name={ability.name}
									description={ability.description}
								/>
							))}

							{member.actions.length > 0 && (
								<div class="mt-2 text-base leading-relaxed">
									{member.actions.length === 1 ? (
										<div class="m-0">
											<strong>{actionHeading(member.actions[0]!)}</strong>{' '}
											<span
												class="inline [&_p]:m-0 [&_p]:inline"
												set:html={teamMemberActionHtml[mi]![0]}
											/>
											{member.actions[0]!.joinNext === 'or' && ' OR:'}
											{member.actions[0]!.joinNext === 'then' && ' Then:'}
										</div>
									) : (
										<ul class="m-0 list-outside list-disc space-y-1.5 pl-5 text-base leading-relaxed">
											{member.actions.map((action, ai) => (
												<li class="m-0 pl-1">
													<strong>{actionHeading(action)}</strong>{' '}
													<span
														class="inline [&_p]:m-0 [&_p]:inline"
														set:html={teamMemberActionHtml[mi]![ai]}
													/>
													{action.joinNext === 'or' && ' OR:'}
													{action.joinNext === 'then' && ' Then:'}
												</li>
											))}
										</ul>
									)}
								</div>
							)}
						</div>
					))}
				</div>
			</>
		)
	}

	{
		(bloodiedHtml || lastStandHtml) && (
			<div class="mt-3 flex flex-col gap-3 border-t border-hairline pt-3 text-base leading-relaxed sm:gap-4">
				{bloodiedHtml && (
					<section class="m-0">
						<h3 class="m-0 text-sm font-bold uppercase tracking-wide">
							Bloodied
						</h3>
						<div
							class="[&_strong]:text-danger [&_p]:m-0"
							set:html={bloodiedHtml}
						/>
					</section>
				)}
				{lastStandHtml && (
					<section class="m-0">
						<h3 class="m-0 text-sm font-bold uppercase tracking-wide">
							Last Stand
						</h3>
						<div
							class="[&_strong]:text-danger [&_p]:m-0"
							set:html={lastStandHtml}
						/>
					</section>
				)}
			</div>
		)
	}

	{
		notesHtml && (
			<div
				class="mt-3 text-base leading-relaxed [&_p]:mb-2 [&_p:last-child]:mb-0"
				set:html={notesHtml}
			/>
		)
	}
</article>
