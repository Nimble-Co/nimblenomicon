---
import bookIcon from '../assets/nimblenomicon_icon.svg';
import bookIconRaw from '../assets/nimblenomicon_icon.svg?raw';
import { HOME_REFERENCE_LINKS } from '../config/home-reference-links';
import { SEARCH_PLACEHOLDER } from '../config/search';
import { SECTION_KEYS, SECTION_METADATA } from '../config/section-sidebars';
import { formatNewsDate, getLatestNimbleNews } from '../utils/nimble-news';
import { searchPageUrl } from '../utils/url';
import project from 'virtual:starlight/project-context';

const newsItems = await getLatestNimbleNews(3);
const searchAction = searchPageUrl(
	import.meta.env.BASE_URL,
	project.trailingSlash,
);

/** Theme-aware hero mark: Starlight header still uses the file as a raster `img`, so we only swap fills here */
const bookIconHtml = bookIconRaw.replaceAll(
	'fill="#2A2526"',
	'fill="currentColor"',
);

const bookNavItems = SECTION_KEYS.map((key) => {
	const m = SECTION_METADATA[key];
	return {
		label: m.label,
		iconSvg: m.iconSvg,
		href: m.path,
	};
});
---

<section
	class="mx-auto flex w-full max-w-none flex-col items-center justify-center gap-[clamp(2rem,5vw,3rem)] px-[max(1rem,env(safe-area-inset-left,0px))] py-8 pb-12 text-center text-fg min-h-[calc(100vh-var(--sl-nav-height)-3rem)]"
	aria-label="Home"
>
	<div
		class="flex w-full max-w-160 flex-col items-center gap-[clamp(1.75rem,4vw,2.5rem)]"
	>
		<div class="flex flex-col items-center gap-5">
			<span
				class="mx-auto block w-[clamp(7rem,22vw,10.5rem)] text-fg [&_svg]:block [&_svg]:h-auto [&_svg]:w-full"
				set:html={bookIconHtml}
				aria-hidden="true"
			/>
			<div class="flex flex-col items-center gap-[0.15em] uppercase">
				<span
					class="font-heading text-[clamp(0.75rem,2vw,0.9375rem)] font-bold italic tracking-[0.2em]"
					>THE</span
				>
				<span
					class="font-heading text-[clamp(1.5rem,5vw,2.35rem)] font-bold italic leading-[1.05] tracking-[0.08em]"
					>NIMBLENOMICON</span
				>
			</div>
		</div>

		<form
			method="get"
			action={searchAction}
			class="box-border flex w-full items-center gap-[0.65rem] rounded-full border border-hairline bg-surface-nav py-[0.65rem] pl-4 pr-4 text-left font-inherit text-fg focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-accent-500"
			role="search"
		>
			<label class="sr-only" for="home-search-q">{SEARCH_PLACEHOLDER}</label>
			<svg
				class="pointer-events-none shrink-0 text-fg-muted opacity-85 dark:opacity-100"
				width="20"
				height="20"
				viewBox="0 0 24 24"
				aria-hidden="true"
			>
				<path
					fill="currentColor"
					d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
				></path>
			</svg>
			<input
				id="home-search-q"
				type="search"
				name="q"
				autocomplete="off"
				placeholder={SEARCH_PLACEHOLDER}
				aria-keyshortcuts="Control+K"
				class="min-w-0 flex-1 border-0 bg-transparent font-sans text-[0.9375rem] text-fg italic outline-none placeholder:text-fg-muted placeholder:italic"
			/>
		</form>

		<ul
			class="m-0 grid w-full list-none grid-cols-2 gap-x-3 gap-y-[0.65rem] p-0"
			role="list"
		>
			{
				bookNavItems.map(({ label, iconSvg, href }) => (
					<li>
						<a
							class="box-border flex min-h-13 w-full items-center gap-[0.6rem] rounded-[0.625rem] border border-hairline bg-gray-200 px-[0.85rem] py-[0.65rem] text-left text-fg no-underline transition-colors duration-75 ease-linear hover:border-fg/30 hover:bg-gray-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500 motion-reduce:transition-none dark:bg-gray-900/60 dark:hover:bg-gray-800"
							href={href}
						>
							<span
								class="inline-flex h-[22px] w-[22px] shrink-0 items-center justify-center text-fg [&_svg]:block [&_svg]:max-h-full [&_svg]:max-w-full [&_svg]:object-contain"
								set:html={iconSvg}
								aria-hidden="true"
							/>
							<span class="font-sans text-[0.8125rem] font-bold italic leading-tight tracking-[0.02em] min-[30rem]:text-sm">
								{label}
							</span>
						</a>
					</li>
				))
			}
		</ul>

		<nav class="w-full text-center" aria-labelledby="home-ref-heading">
			<h2
				class="mb-[0.85rem] mt-0 font-heading text-[clamp(0.7rem,1.8vw,0.8125rem)] font-bold uppercase italic tracking-[0.14em] text-fg-muted"
				id="home-ref-heading"
			>
				Reference
			</h2>
			<ul
				class="m-0 flex list-none flex-wrap items-baseline justify-center gap-x-[0.35rem] gap-y-2 p-0"
				role="list"
			>
				{
					HOME_REFERENCE_LINKS.map(({ label, href }) => (
						<li class="inline-flex max-w-full items-baseline not-last:after:pointer-events-none not-last:after:ml-[0.35rem] not-last:after:font-normal not-last:after:text-fg-muted not-last:after:content-['·']">
							<a
								class="font-sans text-sm font-bold italic leading-[1.35] tracking-[0.02em] text-fg underline decoration-fg/35 decoration-1 underline-offset-[0.15em] transition-colors duration-75 ease-linear hover:decoration-fg focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500 motion-reduce:transition-none min-[30rem]:text-[0.9375rem]"
								href={href}
							>
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>

	{
		newsItems.length > 0 && (
			<section
				class="mx-auto w-full max-w-[min(56rem,100%)] text-center"
				aria-labelledby="home-news-heading"
			>
				<h2
					class="mb-5 mt-0 font-heading text-[clamp(0.7rem,1.8vw,0.8125rem)] font-bold uppercase italic tracking-[0.14em] text-fg-muted"
					id="home-news-heading"
				>
					— Latest News —
				</h2>
				<ul
					class="m-0 grid list-none grid-cols-1 gap-6 p-0 text-center min-[42rem]:grid-cols-3 min-[42rem]:items-stretch min-[42rem]:gap-x-5 min-[42rem]:gap-y-4"
					role="list"
				>
					{newsItems.map((item) => (
						<li class="m-0 flex min-w-0 flex-col">
							<a
								class="flex min-h-full w-full flex-1 flex-col items-center gap-[0.65rem] no-underline text-fg transition-opacity duration-75 ease-linear hover:opacity-90 focus-visible:rounded-[0.625rem] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500 motion-reduce:transition-none"
								href={item.url}
								target="_blank"
								rel="noopener noreferrer"
							>
								<time
									class="font-heading text-[clamp(0.65rem,1.6vw,0.75rem)] font-semibold not-italic tracking-[0.08em] text-fg-muted"
									datetime={item.publishedIso}
								>
									{formatNewsDate(item.publishedIso)}
								</time>
								<span class="flex-[1_1_auto] self-stretch font-heading text-[clamp(0.95rem,2.2vw,1.125rem)] font-bold italic leading-[1.2] tracking-[0.02em] text-fg">
									{item.title}
								</span>
								<span class="box-border block aspect-video w-full shrink-0 self-stretch overflow-hidden rounded-lg border border-hairline bg-gray-200 dark:bg-gray-900/60">
									<img
										class:list={[
											'block h-full w-full',
											item.imageUrl ? 'object-cover' : 'object-contain p-5',
										]}
										src={item.imageUrl ?? bookIcon.src}
										width="640"
										height="360"
										loading="lazy"
										decoding="async"
										alt=""
									/>
								</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
</section>

<script>
	function wireHomeSearchShortcut() {
		const input = document.querySelector<HTMLInputElement>('#home-search-q');
		if (!input) return;
		window.addEventListener('keydown', (e) => {
			if ((e.metaKey === true || e.ctrlKey === true) && e.key === 'k') {
				e.preventDefault();
				input.focus();
			}
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', wireHomeSearchShortcut);
	} else {
		wireHomeSearchShortcut();
	}
</script>
