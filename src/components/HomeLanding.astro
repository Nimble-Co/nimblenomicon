---
import bookIcon from '../assets/nimblenomicon_icon.svg';
import { HOME_REFERENCE_LINKS } from '../config/home-reference-links';
import { SEARCH_PLACEHOLDER } from '../config/search';
---

<section class="home-landing" aria-label="Home">
	<div class="home-landing__brand">
		<img
			class="home-landing__book"
			src={bookIcon.src}
			width="168"
			height="210"
			alt=""
			aria-hidden="true"
		/>
		<div class="home-landing__title-stack">
			<span class="home-landing__the">THE</span>
			<span class="home-landing__name">NIMBLENOMICON</span>
		</div>
	</div>

	<div class="home-landing__search" role="search">
		<button
			type="button"
			class="home-landing__search-trigger"
			aria-label={SEARCH_PLACEHOLDER}
			aria-keyshortcuts="Control+K"
		>
			<svg
				class="home-landing__search-icon"
				width="20"
				height="20"
				viewBox="0 0 24 24"
				aria-hidden="true"
			>
				<path
					fill="currentColor"
					d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
				></path>
			</svg>
			<span class="home-landing__search-placeholder">{SEARCH_PLACEHOLDER}</span>
		</button>
	</div>

	<nav class="home-landing__ref" aria-labelledby="home-ref-heading">
		<h2 class="home-landing__ref-heading" id="home-ref-heading">Reference</h2>
		<ul class="home-landing__ref-list" role="list">
			{
				HOME_REFERENCE_LINKS.map(({ label, href }) => (
					<li class="home-landing__ref-item">
						<a class="home-landing__ref-link" href={href}>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</section>

<script>
	function openHeaderSearch(event: Event) {
		const siteSearch = document.querySelector('site-search');
		const open =
			siteSearch &&
			typeof (siteSearch as HTMLElement & { openSearchModal?: () => void })
				.openSearchModal === 'function'
				? (siteSearch as HTMLElement & { openSearchModal: () => void })
						.openSearchModal
				: undefined;
		if (open) {
			open();
			// Same issue as Search.astro: without this, the opening click can bubble to `window`
			// and hit the outside-click closer (timing varies by browser).
			event.stopPropagation();
			return;
		}
		document
			.querySelector<HTMLButtonElement>('site-search button[data-open-modal]')
			?.click();
	}

	function wireHomeSearch() {
		document
			.querySelector('.home-landing__search-trigger')
			?.addEventListener('click', openHeaderSearch);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', wireHomeSearch);
	} else {
		wireHomeSearch();
	}
</script>

<style>
	.home-landing {
		--home-fg: #252b42;
		--home-muted: #707070;
		--home-border: #c8c8c8;
		--home-input-bg: #ffffff;

		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		min-height: calc(100vh - var(--sl-nav-height) - 3rem);
		max-width: 40rem;
		margin-inline: auto;
		padding-block: 2rem 3rem;
		gap: clamp(1.75rem, 4vw, 2.5rem);
		color: var(--home-fg);
	}

	.home-landing__brand {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
	}

	.home-landing__book {
		width: clamp(7rem, 22vw, 10.5rem);
		height: auto;
		display: block;
	}

	.home-landing__title-stack {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.15em;
		text-transform: uppercase;
	}

	.home-landing__the {
		font-family: var(--nimble-font-heading);
		font-size: clamp(0.75rem, 2vw, 0.9375rem);
		font-weight: 700;
		font-style: italic;
		letter-spacing: 0.2em;
	}

	.home-landing__name {
		font-family: var(--nimble-font-heading);
		font-size: clamp(1.5rem, 5vw, 2.35rem);
		font-weight: 700;
		font-style: italic;
		letter-spacing: 0.08em;
		line-height: 1.05;
	}

	.home-landing__search {
		width: 100%;
	}

	.home-landing__search-trigger {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		width: 100%;
		padding: 0.65rem 1rem;
		border: 1px solid var(--home-border);
		border-radius: 999px;
		background: var(--home-input-bg);
		box-sizing: border-box;
		cursor: pointer;
		font: inherit;
		text-align: left;
		color: inherit;
	}

	.home-landing__search-trigger:focus-visible {
		outline: 2px solid var(--sl-color-accent-high, var(--color-accent-500));
		outline-offset: 2px;
	}

	.home-landing__search-icon {
		flex-shrink: 0;
		color: var(--home-muted);
		opacity: 0.85;
	}

	.home-landing__search-placeholder {
		flex: 1;
		min-width: 0;
		font-family: var(--nimble-search-trigger-font);
		font-size: 0.9375rem;
		font-style: italic;
		color: var(--home-muted);
	}

	.home-landing__ref {
		width: 100%;
		text-align: center;
	}

	.home-landing__ref-heading {
		margin: 0 0 0.85rem;
		font-family: var(--nimble-font-heading);
		font-size: clamp(0.7rem, 1.8vw, 0.8125rem);
		font-weight: 700;
		font-style: italic;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--home-muted);
	}

	.home-landing__ref-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: baseline;
		column-gap: 0.35rem;
		row-gap: 0.5rem;
	}

	.home-landing__ref-item {
		display: inline-flex;
		align-items: baseline;
		max-width: 100%;
	}

	.home-landing__ref-item:not(:last-child)::after {
		content: '·';
		margin-inline-start: 0.35rem;
		color: var(--home-muted);
		font-weight: 400;
		pointer-events: none;
	}

	.home-landing__ref-link {
		font-family: var(--nimble-search-trigger-font);
		font-size: 0.875rem;
		font-weight: 700;
		font-style: italic;
		line-height: 1.35;
		letter-spacing: 0.02em;
		color: var(--home-fg);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.15em;
		text-decoration-color: color-mix(in srgb, var(--home-fg) 35%, transparent);
		transition:
			color 0.08s ease,
			text-decoration-color 0.08s ease;
	}

	.home-landing__ref-link:hover {
		text-decoration-color: var(--home-fg);
	}

	.home-landing__ref-link:focus-visible {
		outline: 2px solid var(--sl-color-accent-high, var(--color-accent-500));
		outline-offset: 2px;
		border-radius: 2px;
	}

	:global(:root[data-theme='dark']) .home-landing {
		--home-fg: var(--sl-color-text);
		--home-muted: var(--sl-color-gray-3);
		--home-border: var(--sl-color-hairline);
		--home-input-bg: var(--sl-color-bg-nav);
	}

	@media (min-width: 30rem) {
		.home-landing__ref-link {
			font-size: 0.9375rem;
		}
	}
</style>
