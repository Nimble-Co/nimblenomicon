---
/**
 * Starlight default shows a right column when `toc` exists.
 * We move the outline into the left Sidebar, so the article uses full width next to it.
 */
---

<div class="lg:sl-flex">
	<div class="main-pane"><slot /></div>
</div>

<style>
	@layer starlight.core {
		.main-pane {
			isolation: isolate;
		}

		@media (min-width: 72rem) {
			.main-pane {
				width: 100%;
			}

			/*
			 * Default Starlight sets a reduced `main-pane` width when a right-hand TOC column exists.
			 * We only render the main column (TOC is in the left sidebar), so that width leaves a
			 * blank strip on the right. Fill the row and center the `sl-container` column.
			 */
			:global([data-has-sidebar][data-has-toc]) .main-pane {
				--sl-content-margin-inline: auto;

				order: 1;
				width: 100%;
			}
		}
	}
</style>
