---
import HeadingBlockList from './ui/HeadingBlockList.astro';
import {
	spellListingBodyMarkdown,
	spellsMatching,
	type SpellListingFilters,
} from '../models/spells';

const filters = Astro.props as SpellListingFilters;

const blocks = spellsMatching(filters).map((spell) => ({
	id: spell.id,
	title: spell.name,
	href: `/spells/${spell.id}/`,
	bodyMarkdown: spellListingBodyMarkdown(spell),
}));
---

<HeadingBlockList blocks={blocks} />
