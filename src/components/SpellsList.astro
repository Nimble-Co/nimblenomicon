---
import { renderMarkdown } from '../lib/render-markdown';
import { spells, type SpellData } from '../models/spells';

const { spellSchoolId, utility = false, secret = false } = Astro.props;
const filteredSpells = spells.filter(
	(spell) =>
		(spellSchoolId ? spell.schoolId === spellSchoolId : true) &&
		spell.utility === utility &&
		spell.secret === secret,
);

function spellMetaMarkdown(spell: SpellData): string {
	const components = [
		spell.tierLabel,
		spell.castingTime?.trim(),
		spell.targetLabel,
	];
	return `_${components.filter(Boolean).join(', ')}_`;
}
---

{
	(
		<>
			{filteredSpells.map(async (spell) => (
				<>
					<h3 id={spell.id}>
						<a href={`/spells/${spell.id}/`}>{spell.name}</a>
					</h3>
					<div
						set:html={await renderMarkdown(
							spellMetaMarkdown(spell) +
								(spell.description?.trim() ? '\n\n' + spell.description : ''),
						)}
					/>
				</>
			))}
		</>
	)
}
