---
import { renderMarkdown } from '../utils/render-markdown';

interface Item {
	id?: string;
	markdown: string;
}

interface Props {
	items: Item[];
	/** Use `p` for stacked paragraphs; `div` for block-level rows without paragraph margins. */
	as?: 'p' | 'div';
}

const { items, as: Tag = 'p' } = Astro.props;

const htmlByIndex = await Promise.all(
	items.map((item: Item) => renderMarkdown(item.markdown)),
);
---

{
	items.map((item: Item, i: number) => (
		<Tag data-auto-link id={item.id} set:html={htmlByIndex[i]} />
	))
}
