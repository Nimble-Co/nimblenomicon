---
import DetailPage from '../../components/DetailPage.astro';
import { weapons } from '../../models/weapons';
import { weaponDetailPageProps } from '../../utils/detail-page-adapters';

export function getStaticPaths() {
	return weapons.map((row) => ({
		params: { id: row.id },
		props: { row },
	}));
}

const { row } = Astro.props;
---

<DetailPage {...weaponDetailPageProps(row)} />
