---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import DetailPageBackToList from '../../components/DetailPageBackToList.astro';
import DetailPageSourceRef from '../../components/DetailPageSourceRef.astro';
import { detailPageBackLinks } from '../../config/detail-page-back-links';
import { renderMarkdown } from '../../lib/render-markdown';
import {
	formatWeaponCategory,
	weaponDetailMarkdown,
	weapons,
} from '../../models/weapons';

export function getStaticPaths() {
	return weapons.map((row) => ({
		params: { id: row.id },
		props: { row },
	}));
}

const { row } = Astro.props;

const cat = formatWeaponCategory(row.category);
const bodyMarkdown = weaponDetailMarkdown(row);

const back = detailPageBackLinks.weapons;
---

<StarlightPage
	hasSidebar={false}
	frontmatter={{
		title: row.name,
		description: `${cat} weapon — ${row.name}.`,
		tableOfContents: false,
		prev: false,
		next: false,
	}}
>
	<DetailPageBackToList href={back.href} label={back.label} />
	<div set:html={await renderMarkdown(bodyMarkdown)} />
	<DetailPageSourceRef
		href={`/core-rules/#${row.id}`}
		sourceName="Core Rules"
	/>
</StarlightPage>
