---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
compareWeaponRowsForListing,
formatWeaponCategory,
weapons,
} from '../../models/weapons';

const rows = [...weapons].sort(compareWeaponRowsForListing);

const idxCell =
	'border-b border-hairline py-[0.35rem] pe-3 ps-0 text-start align-top';
const idxHead = `${idxCell} font-semibold`;
---

<StarlightPage
	frontmatter={{
		title: 'Weapons',
		description:
			"Index of melee and ranged weapons with links to each weapon's stats.",
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<div class="sl-markdown-content not-content">
		<table class="w-full border-collapse">
			<thead>
				<tr>
					<th class={idxHead} scope="col">Name</th>
					<th class={idxHead} scope="col">Category</th>
					<th class={idxHead} scope="col">Damage</th>
					<th class={idxHead} scope="col">Cost</th>
				</tr>
			</thead>
			<tbody>
				{
					rows.map((row) => (
						<tr>
							<th class={idxCell} scope="row">
								<a href={`./${row.id}/`}>{row.name}</a>
							</th>
							<td class={idxCell}>{formatWeaponCategory(row.category)}</td>
							<td class={idxCell}>{row.damage}</td>
							<td class={idxCell}>{row.cost}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</StarlightPage>
