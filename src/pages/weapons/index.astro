---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ReferenceIndexTable from '../../components/ReferenceIndexTable.astro';
import { formatWeaponCategory, weapons } from '../../models/weapons';
import { compareReferenceRowsByName } from '../../utils/reference-index-sort';

const rows = [...weapons].sort(compareReferenceRowsByName);

const columns = [
	{ id: 'name', label: 'Name' },
	{ id: 'category', label: 'Category' },
	{ id: 'damage', label: 'Damage' },
	{ id: 'cost', label: 'Cost' },
];

const tableRows = rows.map((row) => ({
	lead: { href: `./${row.id}/`, text: row.name },
	rest: [formatWeaponCategory(row.category), row.damage, row.cost],
}));
---

<StarlightPage
	frontmatter={{
		title: 'Weapons',
		description:
			'Alphabetical index of melee and ranged weapons with links to each weapon’s stats.',
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<ReferenceIndexTable columns={columns} rows={tableRows} />
</StarlightPage>
