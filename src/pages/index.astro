---
import { attachRouteDataAndRunMiddleware } from '../../node_modules/@astrojs/starlight/utils/routing/middleware';
import { generateStarlightPageRouteData } from '../../node_modules/@astrojs/starlight/utils/starlight-page';
import NimbleHomePage from '../components/NimbleHomePage.astro';
import HomeLanding from '../components/HomeLanding.astro';

const routeData = await generateStarlightPageRouteData({
	props: {
		...Astro.props,
		frontmatter: {
			title: 'Home',
			description: 'The Nimblenomicon — Nimble tabletop RPG reference.',
			template: 'splash',
			tableOfContents: false,
			prev: false,
			next: false,
			pagefind: false,
		},
		hasSidebar: false,
	},
	context: Astro,
});

await attachRouteDataAndRunMiddleware(Astro, routeData);
---

<NimbleHomePage>
	<HomeLanding />
</NimbleHomePage>
