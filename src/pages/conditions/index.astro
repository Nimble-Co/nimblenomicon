---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ReferenceIndexTable from '../../components/ReferenceIndexTable.astro';
import { conditions } from '../../models/conditions';
import { compareReferenceRowsByName } from '../../utils/reference-index-sort';

const columns = [
	{ id: 'name', label: 'Name' },
	{ id: 'description', label: 'Description' },
];

const rows = [...conditions].sort(compareReferenceRowsByName).map((row) => ({
	lead: { href: `./${row.id}/`, text: row.name },
	rest: [row.description],
}));
---

<StarlightPage
	frontmatter={{
		title: 'Conditions',
		description:
			'Alphabetical index of conditions with links to each condition’s full rules.',
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<ReferenceIndexTable columns={columns} rows={rows} />
</StarlightPage>
