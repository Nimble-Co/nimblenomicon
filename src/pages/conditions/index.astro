---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ReferenceIndexTable from '../../components/ReferenceIndexTable.astro';
import {
	compareConditionRowsForListing,
	conditions,
} from '../../models/conditions';

const columns = [{ id: 'name', label: 'Name' }];

const rows = [...conditions]
	.sort(compareConditionRowsForListing)
	.map((row) => ({
		lead: { href: `./${row.id}/`, text: row.name },
		rest: [],
	}));
---

<StarlightPage
	frontmatter={{
		title: 'Conditions',
		description:
			'Alphabetical index of conditions with links to each condition’s full rules.',
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<ReferenceIndexTable columns={columns} rows={rows} />
</StarlightPage>
