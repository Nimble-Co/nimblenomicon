---
import DetailPage from '../../components/DetailPage.astro';
import { conditions } from '../../models/conditions';
import { conditionDetailPageProps } from '../../detail/detail-page-adapters';

export function getStaticPaths() {
	return conditions.map((row) => ({
		params: { id: row.id },
		props: { row },
	}));
}

const { row } = Astro.props;
---

<DetailPage {...conditionDetailPageProps(row)} />
