---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import DetailPageBackToList from '../../components/DetailPageBackToList.astro';
import DetailPageSourceRef from '../../components/DetailPageSourceRef.astro';
import PagefindEntityScope from '../../components/PagefindEntityScope.astro';
import { renderMarkdown } from '../../utils/render-markdown';
import { conditions } from '../../models/conditions';

export function getStaticPaths() {
	return conditions.map((row) => ({
		params: { id: row.id },
		props: { row },
	}));
}

const { row } = Astro.props;

const bodyMarkdown = row.description?.trim() ?? '';
---

<StarlightPage
	hasSidebar={false}
	frontmatter={{
		title: row.name,
		description: `Condition — ${row.name}.`,
		tableOfContents: false,
		prev: false,
		next: false,
	}}
>
	<PagefindEntityScope type="condition" name={row.name}>
		<DetailPageBackToList href="/conditions/" label="All Conditions" />
		<div set:html={await renderMarkdown(bodyMarkdown)} />
		<DetailPageSourceRef
			href={`/core-rules/#${row.id}`}
			sourceName="Core Rules"
		/>
	</PagefindEntityScope>
</StarlightPage>
