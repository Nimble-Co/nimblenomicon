---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { spellSchools } from '../../models/spell-schools';
import { type SpellData, spells } from '../../models/spells';

function compareSpellRowsForListing(a: SpellData, b: SpellData): number {
	const bySchool = a.schoolId.localeCompare(b.schoolId);
	if (bySchool !== 0) return bySchool;
	const byUtility = a.utility ? 1 : 0;
	if (byUtility !== 0) return byUtility;
	const byTier = a.tier - b.tier;
	if (byTier !== 0) return byTier;
	const byName = a.name.localeCompare(b.name);
	if (byName !== 0) return byName;
	return a.tier - b.tier;
}

const spellSchoolShortName = (schoolId: string) =>
	spellSchools.find((school) => school.id === schoolId)?.name ?? schoolId;
---

<StarlightPage
	frontmatter={{
		title: 'Spells',
		description:
			'Alphabetical index of spells by school and tier with links to each spell.',
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<div class="sl-markdown-content not-content">
		<table class="spells-index__table">
			<thead>
				<tr>
					<th scope="col">Name</th>
					<th scope="col">School</th>
					<th scope="col">Tier</th>
					<th scope="col">Utility</th>
					<th scope="col">Secret</th>
				</tr>
			</thead>
			<tbody>
				{
					spells.sort(compareSpellRowsForListing).map((spell) => (
						<tr>
							<th scope="row">
								<a href={`/spells/${spell.id}/`}>{spell.name}</a>
							</th>
							<td>{spellSchoolShortName(spell.schoolId)}</td>
							<td>{spell.tierLabel}</td>
							<td>{spell.utility ? 'Utility' : ''}</td>
							<td>{spell.secret ? 'Secret' : ''}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</StarlightPage>

<style>
	.spells-index__intro {
		font-style: italic;
		margin-bottom: 1rem;
	}
	.spells-index__table {
		width: 100%;
		border-collapse: collapse;
	}
	.spells-index__table th,
	.spells-index__table td {
		text-align: start;
		padding: 0.35rem 0.75rem 0.35rem 0;
		border-bottom: 1px solid var(--sl-color-hairline);
		vertical-align: top;
	}
	.spells-index__table thead th {
		font-weight: 600;
	}
</style>
