---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ReferenceIndexTable from '../../components/ReferenceIndexTable.astro';
import { spellSchools } from '../../models/spell-schools';
import { spells } from '../../models/spells';
import { compareReferenceRowsByName } from '../../utils/reference-index-sort';

const spellSchoolShortName = (schoolId: string) =>
	spellSchools.find((school) => school.id === schoolId)?.name ?? schoolId;

const columns = [
	{ id: 'name', label: 'Name' },
	{ id: 'school', label: 'School' },
	{ id: 'tier', label: 'Tier' },
	{ id: 'utility', label: 'Utility' },
	{ id: 'secret', label: 'Secret' },
];

const rows = [...spells].sort(compareReferenceRowsByName).map((spell) => ({
	lead: { href: `/spells/${spell.id}/`, text: spell.name },
	rest: [
		spellSchoolShortName(spell.schoolId),
		spell.tierLabel,
		spell.utility ? 'Utility' : '',
		spell.secret ? 'Secret' : '',
	],
}));
---

<StarlightPage
	frontmatter={{
		title: 'Spells',
		description: 'Alphabetical index of spells with links to each spell.',
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<ReferenceIndexTable columns={columns} rows={rows} />
</StarlightPage>
