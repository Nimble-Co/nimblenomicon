---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ReferenceIndexTable from '../../components/ReferenceIndexTable.astro';
import { spellSchools } from '../../models/spell-schools';
import { type SpellData, spells } from '../../models/spells';

function compareSpellRowsForListing(a: SpellData, b: SpellData): number {
	const bySchool = a.schoolId.localeCompare(b.schoolId);
	if (bySchool !== 0) return bySchool;
	const byUtility = a.utility ? 1 : 0;
	if (byUtility !== 0) return byUtility;
	const byTier = a.tier - b.tier;
	if (byTier !== 0) return byTier;
	const byName = a.name.localeCompare(b.name);
	if (byName !== 0) return byName;
	return a.tier - b.tier;
}

const spellSchoolShortName = (schoolId: string) =>
	spellSchools.find((school) => school.id === schoolId)?.name ?? schoolId;

const columns = [
	{ id: 'name', label: 'Name' },
	{ id: 'school', label: 'School' },
	{ id: 'tier', label: 'Tier' },
	{ id: 'utility', label: 'Utility' },
	{ id: 'secret', label: 'Secret' },
];

const rows = [...spells].sort(compareSpellRowsForListing).map((spell) => ({
	lead: { href: `/spells/${spell.id}/`, text: spell.name },
	rest: [
		spellSchoolShortName(spell.schoolId),
		spell.tierLabel,
		spell.utility ? 'Utility' : '',
		spell.secret ? 'Secret' : '',
	],
}));
---

<StarlightPage
	frontmatter={{
		title: 'Spells',
		description:
			'Alphabetical index of spells by school and tier with links to each spell.',
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<ReferenceIndexTable columns={columns} rows={rows} />
</StarlightPage>
