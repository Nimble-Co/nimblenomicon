---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { renderMarkdown } from '../../lib/render-markdown';
import { spellSchools } from '../../models/spell-schools';
import { spells, type SpellData } from '../../models/spells';

export function getStaticPaths() {
	return spells.map((spell) => ({
		params: { id: spell.id },
		props: { spell },
	}));
}

const { spell } = Astro.props;

const schoolName =
	spellSchools.find((school) => school.id === spell.schoolId)?.name ??
	spell.schoolId;
function spellMetaMarkdown(spell: SpellData): string {
	const components = [
		spell.tierLabel,
		spell.castingTime.trim(),
		spell.targetLabel,
		spell.utility ? 'Utility' : '',
	];
	return `_${components.filter(Boolean).join(', ')}_`;
}

const bodyMarkdown = spellMetaMarkdown(spell) + '\n\n' + spell.description;
---

<StarlightPage
	hasSidebar={false}
	frontmatter={{
		title: spell.name,
		description: `${schoolName} school — ${spell.name}.`,
		tableOfContents: false,
		prev: false,
		next: false,
	}}
>
	<div set:html={await renderMarkdown(bodyMarkdown)} />
	<p class="spell-detail__core-rules-ref">
		<em>From <a href={`/core-rules/#${spell.id}`}>Core Rules</a></em>
	</p>
</StarlightPage>

<style>
	.spell-detail__core-rules-ref {
		margin-top: 1.5rem;
	}
</style>
