---
import DetailPage from '../../components/DetailPage.astro';
import { buildDetailPathsFromRows } from '../../detail/detail-route-runtime';
import { spells } from '../../models/spells';
import { spellDetailPageProps } from '../../detail/detail-page-adapters';

export function getStaticPaths() {
	return buildDetailPathsFromRows(spells, {
		getId: (spell) => spell.id,
		toProps: (spell) => ({ spell }),
	});
}

const { spell } = Astro.props;
---

<DetailPage {...spellDetailPageProps(spell)} />
