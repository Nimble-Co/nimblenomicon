---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import DetailPageBackToList from '../../components/DetailPageBackToList.astro';
import DetailPageSourceRef from '../../components/DetailPageSourceRef.astro';
import { renderMarkdown } from '../../utils/render-markdown';
import { sourceRefHref, sourceRefLabel } from '../../models/entity-base';
import { spellSchools } from '../../models/spell-schools';
import { spells, type SpellData } from '../../models/spells';

export function getStaticPaths() {
	return spells.map((spell) => ({
		params: { id: spell.id },
		props: { spell },
	}));
}

const { spell } = Astro.props;

const schoolName =
	spellSchools.find((school) => school.id === spell.schoolId)?.name ??
	spell.schoolId;
function spellMetaMarkdown(spell: SpellData): string {
	const components = [
		`${schoolName} Spell`,
		spell.tierLabel,
		spell.castingTime?.trim(),
		spell.targetLabel,
		spell.utility ? 'Utility' : '',
		spell.secret ? 'Secret' : '',
	];
	return `_${components.filter(Boolean).join(', ')}_`;
}

const bodyMarkdown = spellMetaMarkdown(spell) + '\n\n' + spell.description;

const sourceHref = sourceRefHref(spell.source);
const sourceName = sourceRefLabel(spell.source);
---

<StarlightPage
	hasSidebar={false}
	frontmatter={{
		title: spell.name,
		description: `${schoolName} school — ${spell.name}.`,
		tableOfContents: false,
		prev: false,
		next: false,
	}}
>
	<DetailPageBackToList href="/spells/" label="All Spells" />
	<div set:html={await renderMarkdown(bodyMarkdown)} />
	<DetailPageSourceRef href={sourceHref} sourceName={sourceName} />
</StarlightPage>
