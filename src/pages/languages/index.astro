---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
compareLanguageRowsForListing,
languages,
} from '../../models/languages';

const rows = [...languages].sort(compareLanguageRowsForListing);

const idxCell =
	'border-b border-hairline py-[0.35rem] pe-3 ps-0 text-start align-top';
const idxHead = `${idxCell} font-semibold`;
---

<StarlightPage
	frontmatter={{
		title: 'Languages',
		description:
			"Alphabetical index of languages with links to each language's full rules.",
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<div class="sl-markdown-content not-content">
		<table class="w-full border-collapse">
			<thead>
				<tr>
					<th class={idxHead} scope="col">Name</th>
				</tr>
			</thead>
			<tbody>
				{
					rows.map((row) => (
						<tr>
							<th class={idxCell} scope="row">
								<a href={`./${row.id}/`}>{row.name}</a>
							</th>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</StarlightPage>
