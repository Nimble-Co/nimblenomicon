---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ReferenceIndexTable from '../../components/ReferenceIndexTable.astro';
import { languages } from '../../models/languages';
import { compareReferenceRowsByName } from '../../utils/reference-index-sort';

const columns = [
	{ id: 'name', label: 'Name' },
	{ id: 'description', label: 'Description' },
];

const rows = [...languages].sort(compareReferenceRowsByName).map((row) => ({
	lead: { href: `./${row.id}/`, text: row.name },
	rest: [row.description],
}));
---

<StarlightPage
	frontmatter={{
		title: 'Languages',
		description:
			"Alphabetical index of languages with links to each language's full rules.",
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<ReferenceIndexTable columns={columns} rows={rows} />
</StarlightPage>
