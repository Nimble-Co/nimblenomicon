---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
	compareLanguageRowsForListing,
	languages,
} from '../../models/languages';

const rows = [...languages].sort(compareLanguageRowsForListing);
---

<StarlightPage
	frontmatter={{
		title: 'Languages',
		description:
			'Alphabetical index of languages with links to each language’s full rules.',
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<p class="languages-index__intro">
		<a href="/core-rules/">Core Rules</a>
	</p>
	<div class="sl-markdown-content not-content">
		<table class="languages-index__table">
			<thead>
				<tr>
					<th scope="col">Name</th>
				</tr>
			</thead>
			<tbody>
				{
					rows.map((row) => (
						<tr>
							<th scope="row">
								<a href={`./${row.id}/`}>{row.name}</a>
							</th>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</StarlightPage>

<style>
	.languages-index__intro {
		font-style: italic;
		margin-bottom: 1rem;
	}
	.languages-index__table {
		width: 100%;
		border-collapse: collapse;
	}
	.languages-index__table th,
	.languages-index__table td {
		text-align: start;
		padding: 0.35rem 0.75rem 0.35rem 0;
		border-bottom: 1px solid var(--sl-color-hairline);
		vertical-align: top;
	}
	.languages-index__table thead th {
		font-weight: 600;
	}
</style>
