---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ReferenceIndexTable from '../../components/ReferenceIndexTable.astro';
import {
	compareLanguageRowsForListing,
	languages,
} from '../../models/languages';

const columns = [{ id: 'name', label: 'Name' }];

const rows = [...languages].sort(compareLanguageRowsForListing).map((row) => ({
	lead: { href: `./${row.id}/`, text: row.name },
	rest: [],
}));
---

<StarlightPage
	frontmatter={{
		title: 'Languages',
		description:
			'Alphabetical index of languages with links to each language’s full rules.',
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<ReferenceIndexTable columns={columns} rows={rows} />
</StarlightPage>
