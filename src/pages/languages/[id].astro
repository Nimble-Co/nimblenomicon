---
import DetailPage from '../../components/DetailPage.astro';
import { languages } from '../../models/languages';
import { languageDetailPageProps } from '../../detail/detail-page-adapters';

export function getStaticPaths() {
	return languages.map((row) => ({
		params: { id: row.id },
		props: { row },
	}));
}

const { row } = Astro.props;
---

<DetailPage {...languageDetailPageProps(row)} />
