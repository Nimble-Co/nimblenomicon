---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import GmgChaosTable from '../../components/game-masters-guide/GmgChaosTable.astro';
import GmgGoldByLevelTable from '../../components/game-masters-guide/GmgGoldByLevelTable.astro';
import GmgHero from '../../components/game-masters-guide/GmgHero.astro';
import GmgMonsterBuilderTable from '../../components/game-masters-guide/GmgMonsterBuilderTable.astro';
import GmgSecretSpellsList from '../../components/game-masters-guide/GmgSecretSpellsList.astro';
import GmgSnippet from '../../components/game-masters-guide/GmgSnippet.astro';
import GmgTemporaryBoonsTable from '../../components/game-masters-guide/GmgTemporaryBoonsTable.astro';

const bannerContent = `<p>This is free to use for anyone who already owns the content, is trying the system out, or cannot afford to buy it right now. If you enjoy Nimble and are able, please support the game by purchasing the official content at <a href="https://nimbleRPG.com">nimbleRPG.com</a>.</p>`;
---

<StarlightPage
	frontmatter={{
		title: "Game Master's Guide",
		description: "Nimble Game Master's Guide (2.0.3) — text reference.",
		hidePageTitle: true,
		bannerInHero: true,
		banner: { content: bannerContent },
	}}
>
	<GmgHero />

	<GmgSnippet id="starting-as-a-gm" />
	<GmgSnippet id="advanced-gm-tools-intro" />
	<GmgSnippet id="what-you-dont-see" />
	<GmgSnippet id="heroic-vignettes" />
	<GmgSnippet id="making-your-own-adventures" />
	<GmgSnippet id="running-skill-challenges" />
	<GmgSnippet id="what-to-avoid" />
	<GmgSnippet id="adventuring-rewards-intro" />
	<GmgSnippet id="release-valves-and-story-items" />
	<GmgSnippet id="combat-items-and-resting" />
	<GmgSnippet id="secret-spells-intro" />
	<GmgSecretSpellsList />
	<GmgSnippet id="gold-and-lodging" />
	<GmgGoldByLevelTable />
	<GmgTemporaryBoonsTable />
	<GmgSnippet id="boons" />
	<GmgSnippet id="monsters-and-running" />
	<GmgSnippet id="encounter-guidelines-and-tuning" />
	<GmgSnippet id="unique-encounters" />
	<GmgSnippet id="monster-builder-intro" />
	<GmgMonsterBuilderTable />
	<GmgSnippet id="monster-builder-flavor-abilities" />
	<GmgSnippet id="bestiary" />
	<GmgSnippet id="legendary-monsters" />
	<GmgSnippet id="garden-of-death" />
	<GmgSnippet id="valley-of-hope-and-farhope" />
	<GmgSnippet id="adventure-locations-elderwild-through-skyreach" />
	<GmgSnippet id="adventure-locations-growling-through-shadowblight" />
	<GmgSnippet id="5e-conversion" />
	<GmgSnippet id="appendix-of-inspiration" />
	<GmgSnippet id="for-creators-and-more" />
	<GmgSnippet id="chaos-intro" />
	<GmgChaosTable />
</StarlightPage>
