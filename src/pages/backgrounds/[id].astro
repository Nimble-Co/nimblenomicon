---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import DetailPageBackToList from '../../components/DetailPageBackToList.astro';
import DetailPageSourceRef from '../../components/DetailPageSourceRef.astro';
import PagefindEntityScope from '../../components/PagefindEntityScope.astro';
import { renderMarkdown } from '../../utils/render-markdown';
import { backgrounds } from '../../models/backgrounds';

export function getStaticPaths() {
	return backgrounds.map((row) => ({
		params: { id: row.id },
		props: { row },
	}));
}

const { row } = Astro.props;

const bodyMarkdown = row.description?.trim() ?? '';
---

<StarlightPage
	hasSidebar={false}
	frontmatter={{
		title: row.name,
		description: `Character background — ${row.name}.`,
		tableOfContents: false,
		prev: false,
		next: false,
	}}
>
	<PagefindEntityScope type="background" name={row.name}>
		<DetailPageBackToList href="/backgrounds/" label="All Backgrounds" />
		<div set:html={await renderMarkdown(bodyMarkdown)} />
		<DetailPageSourceRef
			href={`/core-rules/#${row.id}`}
			sourceName="Core Rules"
		/>
	</PagefindEntityScope>
</StarlightPage>
