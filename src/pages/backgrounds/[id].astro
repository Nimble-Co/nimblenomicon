---
import DetailPage from '../../components/DetailPage.astro';
import { backgrounds } from '../../models/backgrounds';
import { backgroundDetailPageProps } from '../../detail/detail-page-adapters';

export function getStaticPaths() {
	return backgrounds.map((row) => ({
		params: { id: row.id },
		props: { row },
	}));
}

const { row } = Astro.props;
---

<DetailPage {...backgroundDetailPageProps(row)} />
