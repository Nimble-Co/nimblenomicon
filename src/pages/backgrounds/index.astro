---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ReferenceIndexTable from '../../components/ReferenceIndexTable.astro';
import { backgrounds } from '../../models/backgrounds';
import { compareReferenceRowsByName } from '../../utils/reference-index-sort';

const columns = [{ id: 'name', label: 'Name' }];
const rows = [...backgrounds].sort(compareReferenceRowsByName).map((row) => ({
	lead: { href: `/backgrounds/${row.id}/`, text: row.name },
	rest: [],
}));
---

<StarlightPage
	frontmatter={{
		title: 'Backgrounds',
		description:
			"Alphabetical index of character backgrounds with links to each background's full rules.",
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<ReferenceIndexTable columns={columns} rows={rows} />
</StarlightPage>
