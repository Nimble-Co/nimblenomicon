---
import DetailPage from '../../components/DetailPage.astro';
import { miscAdventuringEquipment } from '../../models/misc-adventuring-equipment';
import { miscEquipmentDetailPageProps } from '../../detail/detail-page-adapters';

export function getStaticPaths() {
	return miscAdventuringEquipment.map((row) => ({
		params: { id: row.id },
		props: { row },
	}));
}

const { row } = Astro.props;
---

<DetailPage {...miscEquipmentDetailPageProps(row)} />
