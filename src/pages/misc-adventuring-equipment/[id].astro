---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import DetailPageBackToList from '../../components/DetailPageBackToList.astro';
import DetailPageSourceRef from '../../components/DetailPageSourceRef.astro';
import PagefindEntityScope from '../../components/PagefindEntityScope.astro';
import { renderMarkdown } from '../../utils/render-markdown';
import {
	miscAdventuringEquipment,
	miscAdventuringEquipmentDetailMarkdown,
} from '../../models/misc-adventuring-equipment';

export function getStaticPaths() {
	return miscAdventuringEquipment.map((row) => ({
		params: { id: row.id },
		props: { row },
	}));
}

const { row } = Astro.props;

const bodyMarkdown = miscAdventuringEquipmentDetailMarkdown(row);
---

<StarlightPage
	hasSidebar={false}
	frontmatter={{
		title: row.name,
		description: `Misc adventuring gear — ${row.name}.`,
		tableOfContents: false,
		prev: false,
		next: false,
	}}
>
	<PagefindEntityScope type="misc-equipment" name={row.name}>
		<DetailPageBackToList
			href="/misc-adventuring-equipment/"
			label="All Misc. Adventuring Equipment"
		/>
		<div set:html={await renderMarkdown(bodyMarkdown)} />
		<DetailPageSourceRef
			href={`/core-rules/#${row.id}`}
			sourceName="Core Rules"
		/>
	</PagefindEntityScope>
</StarlightPage>
