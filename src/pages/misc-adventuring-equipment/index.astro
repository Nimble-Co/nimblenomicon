---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
	compareMiscAdventuringEquipmentRowsForListing,
	miscAdventuringEquipment,
} from '../../models/misc-adventuring-equipment';

const rows = [...miscAdventuringEquipment].sort(
	compareMiscAdventuringEquipmentRowsForListing,
);

const idxCell =
	'border-b border-hairline py-[0.35rem] pe-3 ps-0 text-start align-top';
const idxHead = `${idxCell} font-semibold`;
---

<StarlightPage
	frontmatter={{
		title: 'Misc. Adventuring Equipment',
		description:
			"Index of miscellaneous adventuring gear with links to each item's full rules.",
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<div class="sl-markdown-content not-content">
		<table class="w-full border-collapse">
			<thead>
				<tr>
					<th class={idxHead} scope="col">Name</th>
					<th class={idxHead} scope="col">Cost</th>
				</tr>
			</thead>
			<tbody>
				{
					rows.map((row) => (
						<tr>
							<th class={idxCell} scope="row">
								<a href={`./${row.id}/`}>{row.name}</a>
							</th>
							<td class={idxCell}>{row.cost}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</StarlightPage>
