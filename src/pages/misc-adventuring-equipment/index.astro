---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ReferenceIndexTable from '../../components/ReferenceIndexTable.astro';
import {
	compareMiscAdventuringEquipmentRowsForListing,
	miscAdventuringEquipment,
} from '../../models/misc-adventuring-equipment';

const rows = [...miscAdventuringEquipment].sort(
	compareMiscAdventuringEquipmentRowsForListing,
);
const columns = [
	{ id: 'name', label: 'Name' },
	{ id: 'cost', label: 'Cost' },
];

const tableRows = rows.map((row) => ({
	lead: { href: `./${row.id}/`, text: row.name },
	rest: [row.cost],
}));
---

<StarlightPage
	frontmatter={{
		title: 'Misc. Adventuring Equipment',
		description:
			'Index of miscellaneous adventuring gear with links to each item’s full rules.',
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<ReferenceIndexTable columns={columns} rows={tableRows} />
</StarlightPage>
