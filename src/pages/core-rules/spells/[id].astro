---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { renderMarkdown } from '../../../lib/render-markdown';
import { spellMetaMarkdown } from '../../../lib/spell-meta';
import { spellRows, spellSchoolShortName } from '../../../models/spells';

export function getStaticPaths() {
	return spellRows.map((row) => ({
		params: { id: row.id },
		props: { row },
	}));
}

const { row } = Astro.props;

const schoolName = spellSchoolShortName(row.schoolId);
const sectionLabel = row.utility ? 'Utility Spells' : `${schoolName} Spells`;
const sectionHref = row.utility
	? '../../#utility-spells'
	: `../../#${schoolName.toLowerCase()}-spells`;
const bodyMarkdown =
	spellMetaMarkdown(row.tier, row.castingTime, row.target) +
	(row.description?.trim() ? '\n\n' + row.description : '');
---

<StarlightPage
	frontmatter={{
		title: row.name,
		description: `${sectionLabel} — ${schoolName} school.`,
		tableOfContents: false,
		prev: false,
		next: false,
	}}
>
	<p class="spell-detail__meta">
		<a href={sectionHref}>{sectionLabel}</a>
		{' · '}
		<a href="../../">Core Rules</a>
	</p>
	<div set:html={renderMarkdown(bodyMarkdown)} />
</StarlightPage>

<style>
	.spell-detail__meta {
		font-style: italic;
		margin-bottom: 1rem;
	}
</style>
