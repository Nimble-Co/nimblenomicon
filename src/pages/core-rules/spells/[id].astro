---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { renderMarkdown } from '../../../lib/render-markdown';
import { spellMetaMarkdown } from '../../../lib/spell-meta';
import {
	coreRulesSpellListingFragment,
	spellRows,
	spellSchoolShortName,
} from '../../../models/spells';

export function getStaticPaths() {
	return spellRows.map((row) => ({
		params: { id: row.id },
		props: { row },
	}));
}

const { row } = Astro.props;

const schoolName = spellSchoolShortName(row.schoolId);
const bodyMarkdown =
	spellMetaMarkdown(row.tier, row.castingTime, row.target) +
	(row.description?.trim() ? '\n\n' + row.description : '');
---

<StarlightPage
	hasSidebar={false}
	frontmatter={{
		title: row.name,
		description: `${schoolName} school — ${row.name}.`,
		tableOfContents: false,
		prev: false,
		next: false,
	}}
>
	<div set:html={renderMarkdown(bodyMarkdown)} />
	<p class="spell-detail__core-rules-ref">
		<em
			>From <a href={`../../#${coreRulesSpellListingFragment(row)}`}>Core Rules</a></em
		>
	</p>
</StarlightPage>

<style>
	.spell-detail__core-rules-ref {
		margin-top: 1.5rem;
	}
</style>
