---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
	compareMagicalItemsForListing,
	formatMagicalItemKind,
	magicalItems,
} from '../../models/magical-items';

const rows = [...magicalItems].sort(compareMagicalItemsForListing);
---

<StarlightPage
	frontmatter={{
		title: 'Magic Items',
		description:
			'Index of magic items and wands with links to each item’s full rules.',
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<div class="sl-markdown-content not-content">
		<table class="magical-items-index__table">
			<thead>
				<tr>
					<th scope="col">Name</th>
					<th scope="col">Type</th>
				</tr>
			</thead>
			<tbody>
				{
					rows.map((row) => (
						<tr>
							<th scope="row">
								<a href={`./${row.id}/`}>{row.name}</a>
							</th>
							<td>{formatMagicalItemKind(row.kind)}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</StarlightPage>

<style>
	.magical-items-index__table {
		width: 100%;
		border-collapse: collapse;
	}
	.magical-items-index__table th,
	.magical-items-index__table td {
		text-align: start;
		padding: 0.35rem 0.75rem 0.35rem 0;
		border-bottom: 1px solid var(--sl-color-hairline);
		vertical-align: top;
	}
	.magical-items-index__table thead th {
		font-weight: 600;
	}
</style>
