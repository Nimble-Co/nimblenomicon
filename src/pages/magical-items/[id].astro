---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import DetailPageBackToList from '../../components/DetailPageBackToList.astro';
import DetailPageSourceRef from '../../components/DetailPageSourceRef.astro';
import { renderMarkdown } from '../../utils/render-markdown';
import {
	formatMagicalItemKind,
	magicalItemDetailMarkdown,
	magicalItems,
} from '../../models/magical-items';

export function getStaticPaths() {
	return magicalItems.map((row) => ({
		params: { id: row.id },
		props: { row },
	}));
}

const { row } = Astro.props;

const typeLabel = formatMagicalItemKind(row.kind);
const bodyMarkdown = magicalItemDetailMarkdown(row);
---

<StarlightPage
	hasSidebar={false}
	frontmatter={{
		title: row.name,
		description: `${typeLabel} — ${row.name}.`,
		tableOfContents: false,
		prev: false,
		next: false,
	}}
>
	<DetailPageBackToList href="/magical-items/" label="All Magical Items" />
	<div set:html={await renderMarkdown(bodyMarkdown)} />
	<DetailPageSourceRef
		href={`/core-rules/#${row.id}`}
		sourceName="Core Rules"
	/>
</StarlightPage>
