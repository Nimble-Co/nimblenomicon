---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { renderMarkdown } from '../../lib/render-markdown';
import {
	formatMagicalItemKind,
	magicalItemDetailMarkdown,
	magicalItems,
} from '../../models/magical-items';

export function getStaticPaths() {
	return magicalItems.map((row) => ({
		params: { id: row.id },
		props: { row },
	}));
}

const { row } = Astro.props;

const typeLabel = formatMagicalItemKind(row.kind);
const bodyMarkdown = magicalItemDetailMarkdown(row);
---

<StarlightPage
	hasSidebar={false}
	frontmatter={{
		title: row.name,
		description: `${typeLabel} — ${row.name}.`,
		tableOfContents: false,
		prev: false,
		next: false,
	}}
>
	<div set:html={renderMarkdown(bodyMarkdown)} />
	<p class="magical-item-detail__core-rules-ref">
		<em>From <a href={`/core-rules/#${row.id}`}>Core Rules</a></em>
	</p>
</StarlightPage>

<style>
	.magical-item-detail__core-rules-ref {
		margin-top: 1.5rem;
	}
</style>
