---
import DetailPage from '../../components/DetailPage.astro';
import { magicalItems } from '../../models/magical-items';
import { magicalItemDetailPageProps } from '../../utils/detail-page-adapters';

export function getStaticPaths() {
	return magicalItems.map((row) => ({
		params: { id: row.id },
		props: { row },
	}));
}

const { row } = Astro.props;
---

<DetailPage {...magicalItemDetailPageProps(row)} />
