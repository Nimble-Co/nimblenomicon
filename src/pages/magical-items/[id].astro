---
import DetailPage from '../../components/DetailPage.astro';
import { buildDetailPathsFromRows } from '../../detail/detail-route-runtime';
import { magicalItems } from '../../models/magical-items';
import { magicalItemDetailPageProps } from '../../detail/detail-page-adapters';

export function getStaticPaths() {
	return buildDetailPathsFromRows(magicalItems, {
		getId: (row) => row.id,
		toProps: (row) => ({ row }),
	});
}

const { row } = Astro.props;
---

<DetailPage {...magicalItemDetailPageProps(row)} />
