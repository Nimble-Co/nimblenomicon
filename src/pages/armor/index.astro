---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ReferenceIndexTable from '../../components/ReferenceIndexTable.astro';
import { armorRows, formatArmorCategoryLabel } from '../../models/armor';
import { compareReferenceRowsByName } from '../../utils/reference-index-sort';

const rows = [...armorRows].sort(compareReferenceRowsByName).map((row) => ({
	lead: { href: `./${row.id}/`, text: row.name },
	rest: [formatArmorCategoryLabel(row.category), row.armor, row.cost],
}));

const columns = [
	{ id: 'name', label: 'Name' },
	{ id: 'section', label: 'Section' },
	{ id: 'armor', label: 'Armor' },
	{ id: 'cost', label: 'Cost' },
];
---

<StarlightPage
	frontmatter={{
		title: 'Armor',
		description:
			"Alphabetical index of armor and shields with links to each item's stats.",
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<ReferenceIndexTable columns={columns} rows={rows} />
</StarlightPage>
