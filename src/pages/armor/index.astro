---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
	armorRows,
	compareArmorRowsForListing,
	formatArmorCategoryLabel,
} from '../../models/armor';

const rows = [...armorRows].sort(compareArmorRowsForListing);

const idxCell =
	'border-b border-hairline py-[0.35rem] pe-3 ps-0 text-start align-top';
const idxHead = `${idxCell} font-semibold`;
---

<StarlightPage
	frontmatter={{
		title: 'Armor',
		description:
			'Index of armor and shields by section with links to each item’s stats.',
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<div class="sl-markdown-content not-content">
		<table class="w-full border-collapse">
			<thead>
				<tr>
					<th class={idxHead} scope="col">Name</th>
					<th class={idxHead} scope="col">Section</th>
					<th class={idxHead} scope="col">Armor</th>
					<th class={idxHead} scope="col">Cost</th>
				</tr>
			</thead>
			<tbody>
				{
					rows.map((row) => (
						<tr>
							<th class={idxCell} scope="row">
								<a href={`./${row.id}/`}>{row.name}</a>
							</th>
							<td class={idxCell}>{formatArmorCategoryLabel(row.category)}</td>
							<td class={idxCell}>{row.armor}</td>
							<td class={idxCell}>{row.cost}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</StarlightPage>
