---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ReferenceIndexTable from '../../components/ReferenceIndexTable.astro';
import {
	armorRows,
	compareArmorRowsForListing,
	formatArmorCategoryLabel,
} from '../../models/armor';

const rows = [...armorRows].sort(compareArmorRowsForListing).map((row) => ({
	lead: { href: `./${row.id}/`, text: row.name },
	rest: [formatArmorCategoryLabel(row.category), row.armor, row.cost],
}));

const columns = [
	{ id: 'name', label: 'Name' },
	{ id: 'section', label: 'Section' },
	{ id: 'armor', label: 'Armor' },
	{ id: 'cost', label: 'Cost' },
];
---

<StarlightPage
	frontmatter={{
		title: 'Armor',
		description:
			'Index of armor and shields by section with links to each item’s stats.',
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<ReferenceIndexTable columns={columns} rows={rows} />
</StarlightPage>
