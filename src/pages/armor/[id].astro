---
import DetailPage from '../../components/DetailPage.astro';
import { buildDetailPathsFromRows } from '../../detail/detail-route-runtime';
import { armorRows } from '../../models/armor';
import { armorDetailPageProps } from '../../detail/detail-page-adapters';

export function getStaticPaths() {
	return buildDetailPathsFromRows(armorRows, {
		getId: (row) => row.id,
		toProps: (row) => ({ row }),
	});
}

const { row } = Astro.props;
---

<DetailPage {...armorDetailPageProps(row)} />
