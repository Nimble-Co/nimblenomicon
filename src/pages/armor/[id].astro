---
import DetailPage from '../../components/DetailPage.astro';
import { armorRows } from '../../models/armor';
import { armorDetailPageProps } from '../../detail/detail-page-adapters';

export function getStaticPaths() {
	return armorRows.map((row) => ({
		params: { id: row.id },
		props: { row },
	}));
}

const { row } = Astro.props;
---

<DetailPage {...armorDetailPageProps(row)} />
