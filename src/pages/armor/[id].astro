---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import DetailPageBackToList from '../../components/DetailPageBackToList.astro';
import DetailPageSourceRef from '../../components/DetailPageSourceRef.astro';
import PagefindEntityScope from '../../components/PagefindEntityScope.astro';
import { renderMarkdown } from '../../utils/render-markdown';
import {
	armorDetailMarkdown,
	armorRows,
	formatArmorCategoryLabel,
} from '../../models/armor';

export function getStaticPaths() {
	return armorRows.map((row) => ({
		params: { id: row.id },
		props: { row },
	}));
}

const { row } = Astro.props;

const section = formatArmorCategoryLabel(row.category);
const bodyMarkdown = armorDetailMarkdown(row);
---

<StarlightPage
	hasSidebar={false}
	frontmatter={{
		title: row.name,
		description: `${section} — ${row.name}.`,
		tableOfContents: false,
		prev: false,
		next: false,
	}}
>
	<PagefindEntityScope type="armor" name={row.name}>
		<DetailPageBackToList href="/armor/" label="All Armor" />
		<div set:html={await renderMarkdown(bodyMarkdown)} />
		<DetailPageSourceRef
			href={`/core-rules/#${row.id}`}
			sourceName="Core Rules"
		/>
	</PagefindEntityScope>
</StarlightPage>
