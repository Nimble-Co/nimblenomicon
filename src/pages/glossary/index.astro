---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ReferenceIndexTable from '../../components/ReferenceIndexTable.astro';
import { glossary } from '../../models/glossary';
import { compareReferenceRowsByName } from '../../utils/reference-index-sort';

const sorted = [...glossary].sort(compareReferenceRowsByName);

const columns = [
	{ id: 'term', label: 'Term' },
	{ id: 'description', label: 'Description' },
];

const rows = sorted.map((row) => ({
	lead: { href: `./${row.id}/`, text: row.name },
	rest: [row.description],
}));
---

<StarlightPage
	frontmatter={{
		title: 'Glossary',
		description:
			'Alphabetical glossary of terms with links to each definition.',
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<ReferenceIndexTable columns={columns} rows={rows} />
</StarlightPage>
