---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { compareGlossaryRowsForListing, glossary } from '../../models/glossary';

import ReferenceIndexTable from '../../components/ReferenceIndexTable.astro';

const sorted = [...glossary].sort(compareGlossaryRowsForListing);

const columns = [{ id: 'term', label: 'Term' }];

const rows = sorted.map((row) => ({
	lead: { href: `./${row.id}/`, text: row.name },
	rest: [],
}));
---

<StarlightPage
	frontmatter={{
		title: 'Glossary',
		description:
			'Alphabetical glossary of terms with links to each definition.',
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<ReferenceIndexTable columns={columns} rows={rows} />
</StarlightPage>
