---
import DetailPage from '../../components/DetailPage.astro';
import { glossary } from '../../models/glossary';
import { glossaryDetailPageProps } from '../../utils/detail-page-adapters';

export function getStaticPaths() {
	return glossary.map((row) => ({
		params: { id: row.id },
		props: { row },
	}));
}

const { row } = Astro.props;
---

<DetailPage {...glossaryDetailPageProps(row)} />
