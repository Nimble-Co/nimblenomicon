---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import DetailPageBackToList from '../../components/DetailPageBackToList.astro';
import DetailPageSourceRef from '../../components/DetailPageSourceRef.astro';
import { renderMarkdown } from '../../utils/render-markdown';
import { sourceRefHref, sourceRefLabel } from '../../models/entity-base';
import { glossary } from '../../models/glossary';

export function getStaticPaths() {
	return glossary.map((row) => ({
		params: { id: row.id },
		props: { row },
	}));
}

const { row } = Astro.props;

const bodyMarkdown = row.description?.trim() ?? '';
---

<StarlightPage
	hasSidebar={false}
	frontmatter={{
		title: row.name,
		description: `Glossary — ${row.name}.`,
		tableOfContents: false,
		prev: false,
		next: false,
	}}
>
	<DetailPageBackToList href="/glossary/" label="All Glossary" />
	<div set:html={await renderMarkdown(bodyMarkdown)} />
	<DetailPageSourceRef
		href={sourceRefHref(row.source)}
		sourceName={sourceRefLabel(row.source)}
	/>
</StarlightPage>
