---
import OramaDataSearch from '@components/orama-search/OramaDataSearch.svelte';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
	frontmatter={{
		title: 'Data search',
		description:
			'Search the Nimblenomicon: ancestries, classes, spells, monsters, equipment, and every Nimble reference entry in one place.',
		hidePageTitle: true,
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<OramaDataSearch client:load />
</StarlightPage>

<style is:global>
	/*
	 * `hidePageTitle: true` still leaves an empty Starlight `content-panel` above the slot.
	 * `:first-child` is brittle (other nodes can precede the first panel); `:has(.sl-container > *)`
	 * stays true when Starlight leaves empty wrappers. Hide any main-level panel that does not
	 * contain the search island root — scoped so this only applies when the Orama UI is present.
	 */
	main:has([data-orama-root]) > .content-panel:not(:has([data-orama-root])) {
		display: none;
	}
</style>
