---
import OramaDataSearch from '@components/OramaDataSearch.svelte';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
	frontmatter={{
		title: 'Data search',
		description:
			'Search ancestries, classes, spells, monsters, and other Nimble reference data.',
		hidePageTitle: true,
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<OramaDataSearch client:load />
</StarlightPage>

<style is:global>
	main .content-panel:first-child:not(:has(.sl-container > *)) {
		display: none;
	}
</style>
