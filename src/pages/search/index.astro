---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
	frontmatter={{
		title: 'Data search',
		description:
			'Search ancestries, classes, spells, monsters, and other Nimble reference data.',
		hidePageTitle: true,
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<div class="orama-data-search not-prose max-w-3xl" data-orama-root>
		<p
			class="text-fg-muted min-h-[1.25rem] text-sm"
			data-orama-search-status
			aria-live="polite"
		>
			Loading search index…
		</p>

		<div
			class="mt-4 hidden w-full min-w-0"
			data-orama-type-filter-bar
			role="toolbar"
			aria-label="Filter by data type"
		>
		</div>

		<div class="sr-only" aria-live="polite" data-orama-search-live></div>

		<div data-orama-search-results></div>
	</div>
</StarlightPage>

<script>
	import { initOramaDataSearch } from '../../scripts/orama-search-ui';

	const root = document.querySelector('[data-orama-root]');
	if (root instanceof HTMLElement) {
		initOramaDataSearch(root);
	}
</script>

<style is:global>
	main .content-panel:first-child:not(:has(.sl-container > *)) {
		display: none;
	}
</style>
