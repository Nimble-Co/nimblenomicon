---
import DetailPage from '../../components/DetailPage.astro';
import HeroClassSheet from '../../components/HeroClassSheet.astro';
import type { HeroClassData } from '../../models/class';
import { heroClasses } from '../../models/class';
import { classDetailPageShell } from '../../utils/detail-page-adapters';

export function getStaticPaths() {
	const seen = new Set<string>();
	const paths: Array<{
		params: { id: string };
		props: { heroClass: HeroClassData };
	}> = [];

	for (const c of heroClasses) {
		if (seen.has(c.id)) {
			throw new Error(`Duplicate class page id "${c.id}".`);
		}
		seen.add(c.id);
		paths.push({
			params: { id: c.id },
			props: { heroClass: c },
		});
	}

	return paths;
}

const { heroClass } = Astro.props;
---

<DetailPage {...classDetailPageShell(heroClass)}>
	<HeroClassSheet classId={heroClass.id} />
</DetailPage>
