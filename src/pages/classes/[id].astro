---
import DetailPage from '../../components/DetailPage.astro';
import HeroClassSheet from '../../components/HeroClassSheet.astro';
import { buildDetailPathsFromRows } from '../../detail/detail-route-runtime';
import type { HeroClassData } from '../../models/class';
import { heroClasses } from '../../models/class';
import { classDetailPageShell } from '../../detail/detail-page-adapters';

export function getStaticPaths() {
	return buildDetailPathsFromRows<HeroClassData, { heroClass: HeroClassData }>(
		heroClasses,
		{
			getId: (heroClass) => heroClass.id,
			toProps: (heroClass) => ({ heroClass }),
			duplicateIdError: (id) => `Duplicate class page id "${id}".`,
		},
	);
}

const { heroClass } = Astro.props;
---

<DetailPage {...classDetailPageShell(heroClass)}>
	<HeroClassSheet classId={heroClass.id} />
</DetailPage>
