---
import DetailPage from '../../components/DetailPage.astro';
import LegendaryStatBlock from '../../components/LegendaryStatBlock.astro';
import MonsterStatBlock from '../../components/MonsterStatBlock.astro';
import {
	assertUniqueDetailIds,
	buildDetailPaths,
} from '../../detail/detail-route-runtime';
import type { LegendaryEntryData } from '../../models/legendary-monsters';
import { legendaryMonsters } from '../../models/legendary-monsters';
import type { MonsterData } from '../../models/monsters';
import { monsters } from '../../models/monsters';
import { monsterDetailPageShell } from '../../detail/detail-page-adapters';

export function getStaticPaths() {
	assertUniqueDetailIds(
		monsters,
		(record) => record.id,
		(id) => `Duplicate monster page id "${id}" within regular monsters.`,
	);
	assertUniqueDetailIds(
		legendaryMonsters,
		(record) => record.id,
		(id) => `Duplicate monster page id "${id}" within legendary monsters.`,
	);

	return buildDetailPaths<
		| { variant: 'monster'; record: MonsterData }
		| { variant: 'legendary'; record: LegendaryEntryData }
	>(
		[
			...monsters.map((record) => ({
				id: record.id,
				props: { variant: 'monster' as const, record },
			})),
			...legendaryMonsters.map((record) => ({
				id: record.id,
				props: { variant: 'legendary' as const, record },
			})),
		],
		{
			duplicateIdError: (id) =>
				`Duplicate monster page id "${id}" between regular and legendary monsters.`,
		},
	);
}

const { variant, record } = Astro.props;
---

<DetailPage {...monsterDetailPageShell(variant, record)}>
	{
		variant === 'monster' ? (
			<MonsterStatBlock
				monsterId={record.id}
				showKind={true}
				showFamilyAbilities={true}
			/>
		) : (
			<LegendaryStatBlock legendaryMonsterId={record.id} />
		)
	}
</DetailPage>
