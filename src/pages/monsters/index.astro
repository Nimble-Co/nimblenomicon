---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ReferenceIndexTable from '../../components/ReferenceIndexTable.astro';
import { legendaryMonsters } from '../../models/legendary-monsters';
import { monsters } from '../../models/monsters';

type ListingRow =
	| {
			id: string;
			isLegendary: false;
			name: string;
			level: string;
			kind: string;
			family: string;
			minionLabel: string;
	  }
	| {
			id: string;
			isLegendary: true;
			name: string;
			level: string;
			minionLabel: string;
	  };

const regularRows: ListingRow[] = monsters.map((m) => ({
	id: m.id,
	isLegendary: false,
	name: m.name,
	level: m.level,
	kind: m.kind?.name ?? '',
	family: m.family?.name ?? '',
	minionLabel: m.isMinion ? 'Minion' : '',
}));

const legendaryRows: ListingRow[] = legendaryMonsters.map((m) => ({
	id: m.id,
	name: m.name,
	isLegendary: true,
	level: m.level,
	minionLabel: '',
}));

const rows = [...regularRows, ...legendaryRows];

const columns = [
	{ id: 'name', label: 'Name' },
	{ id: 'level', label: 'Level' },
	{ id: 'legendary', label: 'Legendary' },
	{ id: 'kind', label: 'Kind' },
	{ id: 'family', label: 'Family' },
	{ id: 'minion', label: 'Minion' },
];

const tableRows = rows.map((row) => ({
	lead: { href: `/monsters/${row.id}/`, text: row.name },
	rest: [
		row.level,
		row.isLegendary ? 'Legendary' : '',
		row.isLegendary ? '' : (row.kind ?? ''),
		row.isLegendary ? '' : (row.family ?? ''),
		row.minionLabel,
	],
}));
---

<StarlightPage
	frontmatter={{
		title: 'Monsters',
		description:
			'Index of regular and legendary monsters with links to each stat block.',
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<ReferenceIndexTable columns={columns} rows={tableRows} />
</StarlightPage>
