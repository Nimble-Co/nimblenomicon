---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { legendaryMonsters } from '../../models/legendary-monsters';
import { monsters } from '../../models/monsters';

type ListingRow =
	| {
			id: string;
			isLegendary: false;
			name: string;
			level: string;
			kind: string;
			family: string;
			minionLabel: string;
	  }
	| {
			id: string;
			isLegendary: true;
			name: string;
			level: string;
			minionLabel: string;
	  };

const regularRows: ListingRow[] = monsters.map((m) => ({
	id: m.id,
	isLegendary: false,
	name: m.name,
	level: m.level,
	kind: m.kind?.name ?? '',
	family: m.family?.name ?? '',
	minionLabel: m.isMinion ? 'Minion' : '',
}));

const legendaryRows: ListingRow[] = legendaryMonsters.map((m) => ({
	id: m.id,
	name: m.name,
	isLegendary: true,
	level: m.level,
	minionLabel: '',
}));

const rows = [...regularRows, ...legendaryRows];

const idxCell =
	'border-b border-hairline py-[0.35rem] pe-3 ps-0 text-start align-top';
const idxHead = `${idxCell} font-semibold`;
---

<StarlightPage
	frontmatter={{
		title: 'Monsters',
		description:
			'Index of regular and legendary monsters with links to each stat block.',
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<div class="sl-markdown-content not-content">
		<table class="w-full border-collapse">
			<thead>
				<tr>
					<th class={idxHead} scope="col">Name</th>
					<th class={idxHead} scope="col">Level</th>
					<th class={idxHead} scope="col">Legendary</th>
					<th class={idxHead} scope="col">Kind</th>
					<th class={idxHead} scope="col">Family</th>
					<th class={idxHead} scope="col">Minion</th>
				</tr>
			</thead>
			<tbody>
				{
					rows.map((row) => (
						<tr>
							<th class={idxCell} scope="row">
								<a href={`/monsters/${row.id}/`}>{row.name}</a>
							</th>
							<td class={idxCell}>{row.level}</td>
							<td class={idxCell}>{row.isLegendary ? 'Legendary' : ''}</td>
							<td class={idxCell}>{row.isLegendary ? '' : (row.kind ?? '')}</td>
							<td class={idxCell}>
								{row.isLegendary ? '' : (row.family ?? '')}
							</td>
							<td class={idxCell}>{row.minionLabel}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</StarlightPage>
