---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
	ancestries,
	compareAncestryRowsForListing,
	formatAncestrySize,
} from '../../models/ancestries';

const rows = [...ancestries].sort(compareAncestryRowsForListing);

function sectionLabel(section: (typeof rows)[number]['section']): string {
	return section === 'common' ? 'Common' : 'Exotic';
}

const idxCell =
	'border-b border-hairline py-[0.35rem] pe-3 ps-0 text-start align-top';
const idxHead = `${idxCell} font-semibold`;
---

<StarlightPage
	frontmatter={{
		title: 'Ancestries',
		description:
			"Index of ancestries by section with links to each ancestry's full rules.",
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<div class="sl-markdown-content not-content">
		<table class="w-full border-collapse">
			<thead>
				<tr>
					<th class={idxHead} scope="col">Name</th>
					<th class={idxHead} scope="col">Section</th>
					<th class={idxHead} scope="col">Size</th>
				</tr>
			</thead>
			<tbody>
				{
					rows.map((row) => (
						<tr>
							<th class={idxCell} scope="row">
								<a href={`./${row.id}/`}>{row.name}</a>
							</th>
							<td class={idxCell}>{sectionLabel(row.section)}</td>
							<td class={idxCell}>{formatAncestrySize(row.size)}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</StarlightPage>
