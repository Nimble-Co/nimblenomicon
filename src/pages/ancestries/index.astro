---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ReferenceIndexTable from '../../components/ReferenceIndexTable.astro';
import {
	ancestries,
	compareAncestryRowsForListing,
	formatAncestrySize,
} from '../../models/ancestries';

const rows = [...ancestries].sort(compareAncestryRowsForListing);

function sectionLabel(section: (typeof rows)[number]['section']): string {
	return section === 'common' ? 'Common' : 'Exotic';
}

const columns = [
	{ id: 'name', label: 'Name' },
	{ id: 'section', label: 'Section' },
	{ id: 'size', label: 'Size' },
];

const tableRows = rows.map((row) => ({
	lead: { href: `./${row.id}/`, text: row.name },
	rest: [sectionLabel(row.section), formatAncestrySize(row.size)],
}));
---

<StarlightPage
	frontmatter={{
		title: 'Ancestries',
		description:
			'Index of ancestries by section with links to each ancestry’s full rules.',
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar={false}
>
	<ReferenceIndexTable columns={columns} rows={tableRows} />
</StarlightPage>
