---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { renderMarkdown } from '../../lib/render-markdown';
import { ancestries, formatAncestrySize } from '../../models/ancestries';

export function getStaticPaths() {
	return ancestries.map((row) => ({
		params: { id: row.id },
		props: { row },
	}));
}

const { row } = Astro.props;

const sectionLabel = row.section === 'common' ? 'Common' : 'Exotic';
const bodyMarkdown =
	`**(${formatAncestrySize(row.size)})** ${sectionLabel} ancestry.\n\n` +
	row.flavor +
	'\n\n' +
	row.trait;
---

<StarlightPage
	hasSidebar={false}
	frontmatter={{
		title: row.name,
		description: `${sectionLabel} ancestry — ${row.name}.`,
		tableOfContents: false,
		prev: false,
		next: false,
	}}
>
	<div set:html={renderMarkdown(bodyMarkdown)} />
	<p class="ancestry-detail__core-rules-ref">
		<em>From <a href={`/core-rules/#${row.id}`}>Core Rules</a></em>
	</p>
</StarlightPage>

<style>
	.ancestry-detail__core-rules-ref {
		margin-top: 1.5rem;
	}
</style>
