---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import DetailPageBackToList from '../../components/DetailPageBackToList.astro';
import DetailPageSourceRef from '../../components/DetailPageSourceRef.astro';
import { detailPageBackLinks } from '../../config/detail-page-back-links';
import { renderMarkdown } from '../../lib/render-markdown';
import { ancestries, formatAncestrySize } from '../../models/ancestries';

export function getStaticPaths() {
	return ancestries.map((row) => ({
		params: { id: row.id },
		props: { row },
	}));
}

const { row } = Astro.props;

const sectionLabel = row.section === 'common' ? 'Common' : 'Exotic';
const bodyMarkdown =
	`**(${formatAncestrySize(row.size)})** ${sectionLabel} ancestry.\n\n` +
	row.flavor +
	'\n\n' +
	row.trait;

const back = detailPageBackLinks.ancestries;
---

<StarlightPage
	hasSidebar={false}
	frontmatter={{
		title: row.name,
		description: `${sectionLabel} ancestry — ${row.name}.`,
		tableOfContents: false,
		prev: false,
		next: false,
	}}
>
	<DetailPageBackToList href={back.href} label={back.label} />
	<div set:html={await renderMarkdown(bodyMarkdown)} />
	<DetailPageSourceRef
		href={`/core-rules/#${row.id}`}
		sourceName="Core Rules"
	/>
</StarlightPage>
