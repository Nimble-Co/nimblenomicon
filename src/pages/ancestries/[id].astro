---
import DetailPage from '../../components/DetailPage.astro';
import { ancestries } from '../../models/ancestries';
import { ancestryDetailPageProps } from '../../utils/detail-page-adapters';

export function getStaticPaths() {
	return ancestries.map((row) => ({
		params: { id: row.id },
		props: { row },
	}));
}

const { row } = Astro.props;
---

<DetailPage {...ancestryDetailPageProps(row)} />
